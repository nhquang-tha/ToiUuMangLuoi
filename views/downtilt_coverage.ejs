<%- include('partials/head') %>
<%
    let activeUser = locals.currentUser || locals.user || (typeof currentUser !== 'undefined' ? currentUser : null);
    let rawRole = activeUser && activeUser.role ? activeUser.role : '';
    let normalizedRole = rawRole ? String(rawRole).trim().toLowerCase() : '';
    let sidebarUser = activeUser ? Object.assign({}, activeUser, { role: normalizedRole }) : null;
%>
<style>
    .layout { display: flex; height: 100vh; overflow: hidden; background-color: var(--bg-body); }
    .main-content { flex: 1; overflow-y: auto; padding: 15px; position: relative; }
    
    .topbar { margin-bottom: 15px; padding: 10px 20px; }
    .topbar h1 { margin: 0; font-size: 18px; }
    
    /* Grid Layout cho giao diện ngang */
    .dashboard-grid { 
        display: grid; 
        grid-template-columns: 320px 380px minmax(400px, 1fr); 
        gap: 15px; 
        max-width: 1600px; 
        margin: 0 auto;
        align-items: start;
    }
    
    .panel { 
        background: var(--bg-surface); padding: 15px 20px; border-radius: 10px; 
        box-shadow: var(--shadow-card);
    }

    /* Tiêu đề từng cột */
    .panel-header {
        font-size: 14px; font-weight: 700; color: var(--text-main); 
        border-bottom: 2px solid var(--border-color); 
        padding-bottom: 8px; margin: 0 0 15px 0; 
        display: flex; align-items: center; gap: 8px;
    }
    
    .input-group { margin-bottom: 12px; }
    .input-group label { display: block; margin-bottom: 4px; font-weight: 600; color: var(--text-main); font-size: 12px;}
    .input-row { display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; background: var(--bg-body); transition: all 0.3s; height: 32px;}
    .input-row:focus-within { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15); }
    .input-row input { flex: 1; border: none; padding: 0 10px; outline: none; font-size: 13px; color: var(--text-main); font-weight: bold; background: transparent; width: 100%; height: 100%;}
    .input-row .unit { background: var(--border-color); padding: 0 12px; color: var(--text-muted); font-weight: 700; font-size: 11px; white-space: nowrap; display: flex; align-items: center; justify-content: center; height: 100%;}

    /* Các hộp tính toán (Bài toán 1 & 2) */
    .calc-box { background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; margin-bottom: 15px;}
    .calc-box:last-child { margin-bottom: 0; }
    .calc-box.blue { background: rgba(59, 130, 246, 0.05); border-color: #bfdbfe; }
    .calc-box.green { background: rgba(16, 185, 129, 0.05); border-color: #a7f3d0; }
    
    .calc-title { font-size: 13px; font-weight: bold; margin-bottom: 10px; border-bottom: 1px dashed; padding-bottom: 5px;}
    .calc-box.blue .calc-title { color: var(--primary); border-color: #bfdbfe;}
    .calc-box.green .calc-title { color: var(--success); border-color: #a7f3d0;}

    .result-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px dotted var(--border-color); }
    .result-row:last-child { border-bottom: none; }
    .result-label { font-size: 12px; color: var(--text-muted); font-weight: 600;}
    .result-val { font-size: 13px; font-weight: 800; color: var(--text-main); }
    .val-danger { color: var(--danger); }
    .val-primary { color: var(--primary); }
    .val-success { color: var(--success); }

    .btn-calc { background: var(--cta-gradient); color: white; border: none; padding: 0; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; font-size: 12px; height: 32px; transition: 0.2s; box-shadow: var(--cta-shadow); display: flex; align-items: center; justify-content: center;}
    .btn-calc:hover { transform: translateY(-1px); filter: brightness(1.1); }
    .btn-calc.alt { background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3); }

    /* Visualizer Area */
    .visual-wrapper { display: flex; flex-direction: column; height: calc(100vh - 120px); min-height: 450px;}
    canvas { width: 100%; flex: 1; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 15px; }

    .note-box { background: rgba(245, 158, 11, 0.1); border-left: 4px solid var(--warning); padding: 10px 15px; border-radius: 4px; font-size: 11px; color: var(--text-main); line-height: 1.5; margin: 0;}

    @media (max-width: 1200px) {
        .dashboard-grid { grid-template-columns: 300px minmax(350px, 1fr); }
        .visual-panel { grid-column: span 2; }
        .visual-wrapper { height: 400px; }
    }
    @media (max-width: 768px) {
        .dashboard-grid { grid-template-columns: 1fr; }
        .visual-panel { grid-column: span 1; }
        .visual-wrapper { height: 350px; }
    }
</style>

<div class="layout">
    <%- include('partials/sidebar', { currentUser: sidebarUser }) %>
    <main class="main-content">
        <header class="topbar panel" style="margin-bottom: 15px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h1 style="color: var(--text-main);"><i class="ph-fill ph-ruler" style="color:var(--primary); margin-right:5px;"></i> Căn Chỉnh Góc Ngẩng Anten (Downtilt)</h1>
                    <p style="margin: 3px 0 0 0; color: var(--text-muted); font-size: 12px;">Công cụ chuẩn kỹ thuật vô tuyến mô phỏng vùng phủ búp sóng và kiểm soát nhiễu (Overshoot).</p>
                </div>
            </div>
        </header>
        
        <div class="dashboard-grid">
            
            <!-- CỘT 1: THÔNG SỐ ĐẦU VÀO (INPUT PARAMETERS) -->
            <div class="panel" style="border-top: 4px solid var(--text-muted);">
                <div class="panel-header"><i class="ph-fill ph-sliders"></i> Thông Số Trạm Gốc</div>
                
                <div class="input-group">
                    <label>Độ cao mặt đất (vị trí trạm) so với mực nước biển</label>
                    <div class="input-row">
                        <input type="number" id="h_ground" value="110" step="1">
                        <div class="unit">m</div>
                    </div>
                </div>
                <div class="input-group">
                    <label>Độ cao Anten so với mặt đất (vị trí trạm)</label>
                    <div class="input-row">
                        <input type="number" id="h_ant_agl" value="18" step="1">
                        <div class="unit">m</div>
                    </div>
                </div>
                <div class="input-group">
                    <label>Độ cao khu vực cần phủ sóng so với mực nước biển</label>
                    <div class="input-row">
                        <input type="number" id="h_target" value="42" step="1">
                        <div class="unit">m</div>
                    </div>
                </div>
                <div class="input-group">
                    <label>Vertical Beamwidth (Góc mở búp sóng đứng)</label>
                    <div class="input-row">
                        <input type="number" id="vbw" value="7" step="0.1">
                        <div class="unit">Độ (°)</div>
                    </div>
                </div>
                <div class="input-group" style="margin-bottom: 0;">
                    <label>Tilt điện Anten (Electrical Downtilt gốc)</label>
                    <div class="input-row">
                        <input type="number" id="tilt_elec" value="6" step="0.1">
                        <div class="unit">Độ (°)</div>
                    </div>
                </div>
            </div>

            <!-- CỘT 2: BẢNG TÍNH TOÁN KẾT QUẢ -->
            <div class="panel" style="background: transparent; box-shadow: none; padding: 0;">
                
                <!-- BÀI TOÁN 1 -->
                <div class="calc-box blue">
                    <div class="calc-title"><i class="ph-fill ph-target"></i> Bài Toán 1: Tính Tilt theo Cự ly</div>
                    
                    <div style="display: flex; gap: 10px; align-items: flex-end; margin-bottom: 12px;">
                        <div class="input-group" style="margin: 0; flex: 1;">
                            <label style="color: var(--primary);">Nhập Bán kính cần phủ sóng chính (m)</label>
                            <div class="input-row" style="border-color: #93c5fd;">
                                <input type="number" id="calc1_dist" value="1600" step="10">
                            </div>
                        </div>
                        <button class="btn-calc" style="width: 80px;" onclick="runCalc1()">Tính Toán</button>
                    </div>
                    
                    <div>
                        <div class="result-row">
                            <span class="result-label">Tilt tổng anten (Total Downtilt)</span>
                            <span class="result-val val-primary" id="res1_tilt_total">-- °</span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Tilt cơ anten (Mechanical Downtilt)</span>
                            <span class="result-val val-primary" id="res1_tilt_mech">-- °</span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Bán kính Inner (-3dB trong)</span>
                            <span class="result-val" id="res1_inner">-- m</span>
                        </div>
                        <div class="result-row" style="border-bottom: none; padding-bottom: 0;">
                            <span class="result-label">Bán kính Outer (-3dB ngoài)</span>
                            <span class="result-val" id="res1_outer">-- m</span>
                        </div>
                    </div>
                </div>

                <!-- BÀI TOÁN 2 -->
                <div class="calc-box green">
                    <div class="calc-title"><i class="ph-fill ph-ruler"></i> Bài Toán 2: Tính Cự ly theo Tilt</div>
                    
                    <div style="display: flex; gap: 10px; align-items: flex-end; margin-bottom: 12px;">
                        <div class="input-group" style="margin: 0; flex: 1;">
                            <label style="color: var(--success);">Nhập Tilt tổng Anten (Total Downtilt)</label>
                            <div class="input-row" style="border-color: #6ee7b7;">
                                <input type="number" id="calc2_tilt_total" value="8" step="0.1">
                            </div>
                        </div>
                        <button class="btn-calc alt" style="width: 80px;" onclick="runCalc2()">Tính Toán</button>
                    </div>
                    
                    <div>
                        <div class="result-row">
                            <span class="result-label">Bán kính Inner (-3dB trong)</span>
                            <span class="result-val val-success" id="res2_inner">-- m</span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Bán kính vùng phủ sóng chính (Main)</span>
                            <span class="result-val val-success" id="res2_main">-- m</span>
                        </div>
                        <div class="result-row" style="border-bottom: none; padding-bottom: 0;">
                            <span class="result-label">Bán kính Outer (-3dB ngoài)</span>
                            <span class="result-val val-success" id="res2_outer">-- m</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- CỘT 3: VISUALIZER (MÔ PHỎNG 2D) -->
            <div class="panel visual-panel" style="border-top: 4px solid #8b5cf6;">
                <div class="panel-header" style="margin-bottom: 10px;"><i class="ph-fill ph-monitor-play" style="color: #8b5cf6;"></i> Mô Phỏng Búp Sóng Đứng (Vertical Pattern)</div>
                
                <div class="visual-wrapper">
                    <canvas id="visualCanvas"></canvas>
                    
                    <div class="note-box">
                        <strong>📌 Tiêu chuẩn thiết kế VNPT:</strong> Tầm phủ sóng hiệu quả (Coverage) tính từ bán kính Inner (-3dB) đến Outer (-3dB). <br>Nếu Bán kính ngoài hiển thị <b style="color:var(--danger)">Over Horizon (Vô cực)</b>, búp sóng đang phóng quá đường chân trời gây nhiễu giao thoa (Overshoot). Cần tăng góc Downtilt để dập nhiễu.
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    // Hàm lấy độ cao hiệu dụng (Effective Height)
    function getEffectiveHeight() {
        const h_ground = parseFloat(document.getElementById('h_ground').value) || 0;
        const h_ant_agl = parseFloat(document.getElementById('h_ant_agl').value) || 0;
        const h_target = parseFloat(document.getElementById('h_target').value) || 0;
        // Chiều cao thực tế búp sóng rơi xuống = Cao độ gốc + Chiều cao cột - Cao độ vùng phủ
        let H = (h_ground + h_ant_agl) - h_target;
        return H > 0 ? H : 0.1; // Tránh lỗi chia cho 0
    }

    function runCalc1() {
        const H = getEffectiveHeight();
        const D = parseFloat(document.getElementById('calc1_dist').value) || 1600;
        const vbw = parseFloat(document.getElementById('vbw').value) || 7;
        const tilt_elec = parseFloat(document.getElementById('tilt_elec').value) || 6;

        // 1. Tính Total Tilt từ khoảng cách D
        const rad_total_tilt = Math.atan(H / D);
        const deg_total_tilt = rad_total_tilt * (180 / Math.PI);
        
        // 2. Tính Mech Tilt
        const mech_tilt = deg_total_tilt - tilt_elec;

        // 3. Tính Inner & Outer Radius
        const deg_inner = deg_total_tilt + (vbw / 2);
        const deg_outer = deg_total_tilt - (vbw / 2);

        const rad_inner = deg_inner * (Math.PI / 180);
        const rad_outer = deg_outer * (Math.PI / 180);

        const inner_dist = H / Math.tan(rad_inner);
        
        let outer_text = "";
        let outer_dist = Infinity;
        if (deg_outer <= 0) {
            outer_text = "Over Horizon";
            document.getElementById('res1_outer').className = "result-val val-danger";
        } else {
            outer_dist = H / Math.tan(rad_outer);
            outer_text = outer_dist.toFixed(1);
            document.getElementById('res1_outer').className = "result-val val-primary";
        }

        // Cập nhật UI
        document.getElementById('res1_tilt_total').innerText = deg_total_tilt.toFixed(2);
        document.getElementById('res1_tilt_mech').innerText = mech_tilt.toFixed(2);
        document.getElementById('res1_inner').innerText = inner_dist.toFixed(1);
        document.getElementById('res1_outer').innerText = outer_text;

        // Vẽ biểu đồ
        drawVisual(H, inner_dist, D, outer_dist, deg_outer <= 0);
    }

    function runCalc2() {
        const H = getEffectiveHeight();
        const tilt_total = parseFloat(document.getElementById('calc2_tilt_total').value) || 8;
        const vbw = parseFloat(document.getElementById('vbw').value) || 7;

        const deg_main = tilt_total;
        const deg_inner = tilt_total + (vbw / 2);
        const deg_outer = tilt_total - (vbw / 2);

        const rad_main = deg_main * (Math.PI / 180);
        const rad_inner = deg_inner * (Math.PI / 180);
        const rad_outer = deg_outer * (Math.PI / 180);

        const main_dist = H / Math.tan(rad_main);
        const inner_dist = H / Math.tan(rad_inner);
        
        let outer_text = "";
        let outer_dist = Infinity;
        if (deg_outer <= 0) {
            outer_text = "Over Horizon";
            document.getElementById('res2_outer').className = "result-val val-danger";
        } else {
            outer_dist = H / Math.tan(rad_outer);
            outer_text = outer_dist.toFixed(1);
            document.getElementById('res2_outer').className = "result-val val-success";
        }

        // Cập nhật UI
        document.getElementById('res2_inner').innerText = inner_dist.toFixed(1);
        document.getElementById('res2_main').innerText = main_dist.toFixed(1);
        document.getElementById('res2_outer').innerText = outer_text;

        // Vẽ biểu đồ
        drawVisual(H, inner_dist, main_dist, outer_dist, deg_outer <= 0);
    }

    // Engine vẽ mô phỏng HTML5 Canvas
    function drawVisual(H, d_inner, d_main, d_outer, isInfinity) {
        const canvas = document.getElementById('visualCanvas');
        const ctx = canvas.getContext('2d');
        
        // Cập nhật kích thước thực tế
        canvas.width = canvas.clientWidth;
        canvas.height = canvas.clientHeight;
        const w = canvas.width;
        const h = canvas.height;

        ctx.clearRect(0, 0, w, h);

        // Thiết lập padding và tọa độ gốc trạm
        const padX = 40;
        const padY = 40;
        const towerX = padX;
        const groundY = h - padY;
        const towerTopY = padY; 
        
        // Tỷ lệ xích (Scale)
        const maxDistRender = isInfinity ? d_main * 2.5 : d_outer * 1.1; 
        const scaleX = (w - padX * 2) / maxDistRender;

        // 1. VẼ NỀN VÀ MẶT ĐẤT
        ctx.fillStyle = '#f8fafc'; // Trời
        ctx.fillRect(0, 0, w, groundY);
        ctx.fillStyle = '#f0fdf4'; // Đất
        ctx.fillRect(0, groundY, w, h - groundY);
        
        // Đường mặt đất nét đứt
        ctx.beginPath();
        ctx.moveTo(0, groundY);
        ctx.lineTo(w, groundY);
        ctx.strokeStyle = '#22c55e';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([8, 4]);
        ctx.stroke();
        ctx.setLineDash([]);

        // Đường chân trời nét đứt
        ctx.beginPath();
        ctx.moveTo(towerX, towerTopY);
        ctx.lineTo(w, towerTopY);
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([5, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#64748b';
        ctx.font = 'bold 11px Inter';
        ctx.fillText('0° (Horizon)', w - 70, towerTopY - 8);

        // 2. VẼ THÁP (TOWER)
        ctx.beginPath();
        ctx.moveTo(towerX - 12, groundY);
        ctx.lineTo(towerX - 4, towerTopY + 20);
        ctx.lineTo(towerX + 4, towerTopY + 20);
        ctx.lineTo(towerX + 12, groundY);
        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        
        // Cấu trúc chéo của tháp
        ctx.beginPath();
        let crossInterval = (groundY - (towerTopY + 20)) / 4;
        for(let i=1; i<4; i++) {
            let yCross = groundY - i*crossInterval;
            ctx.moveTo(towerX - 10 + i*2, yCross);
            ctx.lineTo(towerX + 8 - i*2, yCross - crossInterval);
            ctx.moveTo(towerX + 10 - i*2, yCross);
            ctx.lineTo(towerX - 8 + i*2, yCross - crossInterval);
        }
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 1;
        ctx.stroke();

        // Ăng ten
        ctx.fillStyle = '#475569';
        ctx.fillRect(towerX - 3, towerTopY, 6, 25);

        // Ký hiệu chiều cao H
        ctx.beginPath();
        ctx.moveTo(towerX - 25, towerTopY); ctx.lineTo(towerX - 25, groundY);
        ctx.moveTo(towerX - 30, towerTopY); ctx.lineTo(towerX - 20, towerTopY);
        ctx.moveTo(towerX - 30, groundY); ctx.lineTo(towerX - 20, groundY);
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.fillStyle = '#1e293b';
        ctx.font = 'bold 12px Inter';
        ctx.fillText(`H=${H}m`, towerX - 75, (towerTopY + groundY) / 2);

        // 3. XÁC ĐỊNH TỌA ĐỘ TIA
        const px_inner = towerX + (d_inner * scaleX);
        const px_main = towerX + (d_main * scaleX);
        let px_outer, py_outer;
        
        if (isInfinity) {
            px_outer = w;
            const rad_up = Math.atan(H / d_main) - (parseFloat(document.getElementById('vbw').value) * Math.PI / 180 / 2);
            py_outer = towerTopY - Math.tan(Math.abs(rad_up)) * (w - towerX);
        } else {
            px_outer = towerX + (d_outer * scaleX);
            py_outer = groundY;
        }

        // 4. VẼ VÙNG PHỦ BÚP SÓNG
        ctx.beginPath();
        ctx.moveTo(towerX, towerTopY + 12);
        ctx.lineTo(px_outer, py_outer); 
        ctx.lineTo(px_inner, groundY);
        ctx.closePath();
        
        let beamGrad = ctx.createLinearGradient(towerX, towerTopY, px_main, groundY);
        beamGrad.addColorStop(0, 'rgba(139, 92, 246, 0.4)');   // Tím nhạt ở gốc (để hợp màu Panel)
        beamGrad.addColorStop(1, 'rgba(16, 185, 129, 0.15)');  // Xanh lá ở rìa
        ctx.fillStyle = beamGrad;
        ctx.fill();

        // 5. VẼ TIA
        const drawRay = (x, y, color, dash = []) => {
            ctx.beginPath();
            ctx.moveTo(towerX, towerTopY + 12);
            ctx.lineTo(x, y);
            ctx.strokeStyle = color;
            ctx.lineWidth = 1.5;
            ctx.setLineDash(dash);
            ctx.stroke();
            ctx.setLineDash([]);
        };

        drawRay(px_inner, groundY, '#8b5cf6'); // Inner
        drawRay(px_outer, py_outer, '#8b5cf6'); // Outer
        drawRay(px_main, groundY, '#0f172a', [5, 4]); // Main

        // 6. GHI CHÚ
        ctx.fillStyle = '#0f172a';
        ctx.font = 'bold 11px Inter';
        
        // Inner
        ctx.fillText(`Inner: ${d_inner.toFixed(0)}m`, px_inner - 25, groundY + 15);
        
        // Outer
        if (isInfinity) {
            ctx.fillStyle = '#dc2626';
            ctx.fillText(`Over Horizon`, w - 80, py_outer - 10);
            ctx.beginPath(); ctx.arc(w - 5, py_outer, 4, 0, 2 * Math.PI); ctx.fill();
        } else {
            ctx.fillText(`Outer: ${d_outer.toFixed(0)}m`, px_outer - 40, groundY + 15);
        }

        // Góc Beamwidth
        const arcRadius = 100;
        const rad_total = Math.atan(H / d_main);
        const bw_rad = parseFloat(document.getElementById('vbw').value) * Math.PI / 180;
        const startAngle = rad_total - bw_rad/2;
        const endAngle = rad_total + bw_rad/2;
        
        ctx.beginPath();
        ctx.arc(towerX, towerTopY + 12, arcRadius, startAngle, endAngle);
        ctx.strokeStyle = '#8b5cf6';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        
        const p1X = towerX + arcRadius * Math.cos(startAngle);
        const p1Y = towerTopY + 12 + arcRadius * Math.sin(startAngle);
        ctx.fillStyle = '#8b5cf6';
        ctx.fillText(`Beamwidth`, p1X + 5, p1Y + 5);

        // Góc Tilt
        ctx.beginPath();
        ctx.arc(towerX, towerTopY + 12, 180, 0, rad_total);
        ctx.strokeStyle = '#64748b';
        ctx.setLineDash([3, 3]);
        ctx.stroke();
        ctx.setLineDash([]);
        const dtLabelX = towerX + 190 * Math.cos(rad_total/2);
        const dtLabelY = towerTopY + 12 + 190 * Math.sin(rad_total/2);
        ctx.fillStyle = '#475569';
        ctx.fillText(`Tilt Angle`, dtLabelX, dtLabelY);
    }

    // Tự động resize Canvas khi thu/phóng cửa sổ
    window.addEventListener('resize', () => {
        // Debounce resize
        clearTimeout(window.resizeTimer);
        window.resizeTimer = setTimeout(() => {
            runCalc1(); 
        }, 150);
    });

    window.onload = () => { runCalc1(); };
</script>
