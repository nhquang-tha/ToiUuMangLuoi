<%- include('partials/head') %>
<%
    let activeUser = locals.currentUser || locals.user || (typeof currentUser !== 'undefined' ? currentUser : null);
    let rawRole = activeUser && activeUser.role ? activeUser.role : '';
    let normalizedRole = rawRole ? String(rawRole).trim().toLowerCase() : '';
    let sidebarUser = activeUser ? Object.assign({}, activeUser, { role: normalizedRole }) : null;
%>
<style>
    .layout { display: flex; height: 100vh; overflow: hidden; background-color: #f4f6f8; }
    .main-content { flex: 1; overflow-y: auto; padding: 20px; position: relative; }
    
    .filter-card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px; display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; border-top: 4px solid #8e44ad;}
    
    .tab-header { display: flex; border-bottom: 2px solid #ecf0f1; margin-bottom: 0; flex-wrap: wrap;}
    .tab-btn { background: #fdfdfd; border: 1px solid #ecf0f1; border-bottom: none; padding: 12px 20px; cursor: pointer; font-size: 13px; font-weight: bold; color: #7f8c8d; transition: 0.3s; position: relative; border-radius: 8px 8px 0 0; margin-right: 5px;}
    .tab-btn:hover { color: #8e44ad; }
    .tab-btn.active { color: #8e44ad; background: #f4ecf8; border-color: #e1cbed; border-bottom: 3px solid #8e44ad; }
    .badge-count { position: absolute; top: -5px; right: -5px; background: #e74c3c; color: white; font-size: 10px; padding: 2px 6px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);}

    .tab-content { display: none; animation: fadeIn 0.4s; }
    .tab-content.active { display: block; }

    /* CẤU HÌNH BẢNG & PHÂN TRANG */
    .table-wrapper { width: 100%; max-height: 55vh; overflow-y: auto; overflow-x: auto; background: #fff; border: 1px solid #e1cbed; border-top: none; }
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; white-space: nowrap; }
    .data-table th, .data-table td { padding: 12px 15px; border-bottom: 1px solid #ecf0f1; text-align: left; }
    .data-table th { background-color: #f8f9fa; color: #2c3e50; font-weight: bold; position: sticky; top: 0; z-index: 10; box-shadow: 0 2px 2px -1px rgba(0,0,0,0.1);}
    .data-table tbody tr:hover td { background-color: #f4ecf8; }

    .pagination-bar { padding: 10px 15px; background: #fdfdfd; border: 1px solid #e1cbed; border-top: none; border-radius: 0 0 8px 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
    .page-info select { padding: 4px 8px; border-radius: 4px; border: 1px solid #bdc3c7; outline: none; cursor: pointer; font-weight: bold;}
    .page-controls { display: flex; gap: 5px; }
    .btn-page { background: #fff; border: 1px solid #bdc3c7; padding: 4px 10px; border-radius: 4px; cursor: pointer; color: #34495e; font-weight: bold; transition: 0.2s;}
    .btn-page:hover:not(:disabled) { background: #8e44ad; color: white; border-color: #8e44ad; }
    .btn-page.active { background: #8e44ad; color: white; border-color: #8e44ad; }
    .btn-page:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-kpi { background: #3498db; color: white; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-size: 11px; font-weight: bold; display: inline-block; transition: 0.2s; border: 1px solid #2980b9; }
    .btn-kpi:hover { background: #2980b9; transform: scale(1.05); }

    .net-badge-3g { background: #e3f2fd; color: #2980b9; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; border: 1px solid #bce0fd;}
    .net-badge-4g { background: #f4ecf8; color: #8e44ad; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; border: 1px solid #e1cbed;}
    .net-badge-5g { background: #e8f8f5; color: #16a085; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; border: 1px solid #bce8e0;}

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<div class="layout">
    <%- include('partials/sidebar', { currentUser: sidebarUser }) %>
    <main class="main-content">
        <header class="topbar">
            <h1>Cảnh Báo Giám Sát: Traffic Down</h1>
        </header>
        
        <div class="content-body">
            
            <div class="filter-card">
                <div style="flex: 1; min-width: 250px;">
                    <p style="margin: 0 0 5px 0; color: #7f8c8d; font-size: 14px;">Thuật toán tự động nhận diện dữ liệu mới nhất (3G, 4G & 5G) để phân tích đối soát tuần.</p>
                    <div id="dateInfo" style="font-weight: bold; color: #8e44ad; font-size: 16px;">
                        Ngày phân tích: <span style="color:#2c3e50;">[Chưa lấy dữ liệu]</span>
                    </div>
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button onclick="fetchTrafficDown()" class="btn-primary" style="background: #8e44ad; color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; height: 45px; font-size: 14px; transition: 0.2s;">
                        🔍 Bắt Đầu Phân Tích
                    </button>
                    <button onclick="exportToExcel()" id="btnExport" class="btn-success" style="background: #27ae60; color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; height: 45px; font-size: 14px; display: none;">
                        📥 Xuất Excel (Tất Cả)
                    </button>
                </div>
            </div>

            <!-- HƯỚNG DẪN / THÔNG BÁO TIÊU CHÍ LỌC -->
            <div id="initMsg" style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 20px; font-size: 14px; color: #34495e;">
                <strong>💡 Các tiêu chí Lọc Traffic (Luôn xét KPI của ngày mới nhất):</strong><br>
                <span style="color: #e74c3c">1. Không Lưu Lượng ≥ 7 Ngày:</span> Traffic từ 7 ngày trở lên bằng 0 GB <strong>VÀ</strong> Traffic TB lúc trạm còn sống > 1 GB.<br>
                <span style="color: #e67e22">2. Không Lưu Lượng ≥ 3 Ngày:</span> Traffic từ 3 đến dưới 7 ngày = 0 GB <strong>VÀ</strong> Traffic TB lúc trạm còn sống > 1 GB.<br>
                <span style="color: #f1c40f">3. Không Lưu Lượng Mới 1 Ngày:</span> Traffic ngày mới nhất = 0 GB, ngày liền trước đó > 0 GB <strong>VÀ</strong> Traffic TB > 1 GB.<br>
                <span style="color: #3498db">4. Cell Suy Giảm (4G/5G):</span> T0 < 70% T7 <strong>VÀ</strong> T7 > 1 GB <strong>VÀ</strong> 3 ngày gần nhất đều giảm so với cùng kỳ.<br>
                <span style="color: #8e44ad">5. POI Suy Giảm (Gộp chung 4G+5G):</span> Traffic POI T0 < 70% T7 <strong>VÀ</strong> 3 ngày gần nhất đều giảm so với cùng kỳ.
            </div>

            <div id="loadingMsg" style="display: none; text-align: center; padding: 30px; color: #8e44ad; font-size: 16px; font-weight: bold; background: white; border-radius: 8px; margin-bottom: 15px;">
                <span style="display: inline-block; animation: spin 1s linear infinite;">⏳</span> Đang đối soát lưu lượng mạng lưới...
            </div>
            <div id="errorMsg" style="display: none; text-align: center; padding: 20px; color: #e74c3c; font-weight: bold; background: #fdf2f2; border: 1px solid #fad2d2; border-radius: 8px; margin-bottom: 15px;"></div>

            <div id="dashboardArea" style="display: none;">
                <!-- HỆ THỐNG TABS -->
                <div class="tab-header">
                    <button class="tab-btn active" onclick="openTab(event, 'Z7')">Zero ≥ 7 Ngày <span class="badge-count" id="cZ7">0</span></button>
                    <button class="tab-btn" onclick="openTab(event, 'Z3')">Zero ≥ 3 Ngày <span class="badge-count" id="cZ3" style="background:#e67e22;">0</span></button>
                    <button class="tab-btn" onclick="openTab(event, 'Z1')">Zero 1 Ngày <span class="badge-count" id="cZ1" style="background:#f1c40f;">0</span></button>
                    <button class="tab-btn" onclick="openTab(event, 'DC')">Sụt Giảm (Cell) <span class="badge-count" id="cDC" style="background:#3498db;">0</span></button>
                    <button class="tab-btn" onclick="openTab(event, 'DP')">Sụt Giảm (POI) <span class="badge-count" id="cDP" style="background:#1abc9c;">0</span></button>
                </div>

                <!-- CÁC KHUNG BẢNG -->
                <div id="tabZ7" class="tab-content active">
                    <div class="table-wrapper"><table class="data-table"><thead><tr><th>#</th><th>Tên Cell (Mất lưu lượng)</th><th>Mạng</th><th>Số Ngày Mất</th><th>Hôm nay (GB)</th><th>TB Lịch sử (GB)</th><th>Thao Tác</th></tr></thead><tbody id="bodyZ7"></tbody></table></div>
                    <div class="pagination-bar"><div class="page-info">Hiển thị <select id="sizeZ7" onchange="changePageSize('Z7')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div><div class="page-controls" id="pageControlsZ7"></div></div>
                </div>

                <div id="tabZ3" class="tab-content">
                    <div class="table-wrapper"><table class="data-table"><thead><tr><th>#</th><th>Tên Cell (Mất lưu lượng)</th><th>Mạng</th><th>Số Ngày Mất</th><th>Hôm nay (GB)</th><th>TB Lịch sử (GB)</th><th>Thao Tác</th></tr></thead><tbody id="bodyZ3"></tbody></table></div>
                    <div class="pagination-bar"><div class="page-info">Hiển thị <select id="sizeZ3" onchange="changePageSize('Z3')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div><div class="page-controls" id="pageControlsZ3"></div></div>
                </div>

                <div id="tabZ1" class="tab-content">
                    <div class="table-wrapper"><table class="data-table"><thead><tr><th>#</th><th>Tên Cell (Mất lưu lượng)</th><th>Mạng</th><th>Hôm nay (GB)</th><th>Hôm qua (GB)</th><th>Thao Tác</th></tr></thead><tbody id="bodyZ1"></tbody></table></div>
                    <div class="pagination-bar"><div class="page-info">Hiển thị <select id="sizeZ1" onchange="changePageSize('Z1')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div><div class="page-controls" id="pageControlsZ1"></div></div>
                </div>

                <div id="tabDC" class="tab-content">
                    <div class="table-wrapper"><table class="data-table"><thead><tr><th>#</th><th>Tên Cell (Sụt giảm mạnh)</th><th>Mạng</th><th>Hôm nay (GB)</th><th>Cùng kỳ tuần trước (GB)</th><th>Tỷ lệ đạt được</th><th>Thao Tác</th></tr></thead><tbody id="bodyDC"></tbody></table></div>
                    <div class="pagination-bar"><div class="page-info">Hiển thị <select id="sizeDC" onchange="changePageSize('DC')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div><div class="page-controls" id="pageControlsDC"></div></div>
                </div>

                <div id="tabDP" class="tab-content">
                    <div class="table-wrapper"><table class="data-table"><thead><tr><th>#</th><th>Khu vực POI</th><th>Mạng</th><th>Hôm nay (GB)</th><th>Cùng kỳ tuần trước (GB)</th><th>Tỷ lệ đạt được</th><th>Thao Tác</th></tr></thead><tbody id="bodyDP"></tbody></table></div>
                    <div class="pagination-bar"><div class="page-info">Hiển thị <select id="sizeDP" onchange="changePageSize('DP')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div><div class="page-controls" id="pageControlsDP"></div></div>
                </div>

            </div>
        </div>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const xlsxScript = document.createElement('script');
        xlsxScript.src = atob('aHR0cHM6Ly91bnBrZy5jb20veGxzeC9kaXN0L3hsc3guZnVsbC5taW4uanM=');
        document.head.appendChild(xlsxScript);
    });

    const T_STATE = {
        'Z7': { data: [], page: 1, size: 20 },
        'Z3': { data: [], page: 1, size: 20 },
        'Z1': { data: [], page: 1, size: 20 },
        'DC': { data: [], page: 1, size: 20 },
        'DP': { data: [], page: 1, size: 20 }
    };

    function openTab(evt, tabId) {
        let i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) tabcontent[i].classList.remove("active");
        tablinks = document.getElementsByClassName("tab-btn");
        for (i = 0; i < tablinks.length; i++) tablinks[i].classList.remove("active");
        document.getElementById('tab' + tabId).classList.add("active");
        evt.currentTarget.classList.add("active");
    }

    async function fetchTrafficDown() {
        document.getElementById('loadingMsg').style.display = 'block';
        document.getElementById('errorMsg').style.display = 'none';
        document.getElementById('dashboardArea').style.display = 'none';
        document.getElementById('btnExport').style.display = 'none';

        try {
            const response = await fetch(`/api/traffic-down-data`);
            const data = await response.json();
            document.getElementById('loadingMsg').style.display = 'none';

            // [FIX]: Bắt lỗi trực tiếp từ Backend để hiển thị thay vì hiện 'undefined'
            if (data.error) {
                document.getElementById('errorMsg').innerText = data.error;
                document.getElementById('errorMsg').style.display = 'block';
                return;
            }

            document.getElementById('dateInfo').innerHTML = `Ngày phân tích: <span style="color:#e74c3c;">${data.latestDate}</span> | Cùng kỳ tuần trước: <span style="color:#e74c3c;">${data.lastWeekDate}</span>`;

            T_STATE['Z7'].data = data.zero_7d || []; document.getElementById('cZ7').innerText = T_STATE['Z7'].data.length;
            T_STATE['Z3'].data = data.zero_3d || []; document.getElementById('cZ3').innerText = T_STATE['Z3'].data.length;
            T_STATE['Z1'].data = data.zero_1d || []; document.getElementById('cZ1').innerText = T_STATE['Z1'].data.length;
            T_STATE['DC'].data = data.droppedTrafficCells || []; document.getElementById('cDC').innerText = T_STATE['DC'].data.length;
            T_STATE['DP'].data = data.droppedTrafficPOIs || []; document.getElementById('cDP').innerText = T_STATE['DP'].data.length;

            renderTable('Z7'); renderTable('Z3'); renderTable('Z1'); renderTable('DC'); renderTable('DP');

            document.getElementById('dashboardArea').style.display = 'block';
            document.getElementById('btnExport').style.display = 'block';

        } catch (error) { 
            document.getElementById('loadingMsg').style.display = 'none'; 
            document.getElementById('errorMsg').innerText = 'Lỗi mất kết nối với máy chủ CSDL'; 
            document.getElementById('errorMsg').style.display = 'block'; 
        }
    }

    function getNetBadge(net) {
        if (net === '5g') return '<span class="net-badge-5g">5G</span>';
        if (net === '4g') return '<span class="net-badge-4g">4G</span>';
        if (net === '4g_5g') return '<span class="net-badge-4g">4G</span> <span class="net-badge-5g">5G</span>';
        return '<span class="net-badge-3g">3G</span>';
    }

    function renderTable(type) {
        const tbody = document.getElementById('body' + type);
        tbody.innerHTML = '';
        
        let state = T_STATE[type];
        const start = (state.page - 1) * state.size;
        const pageData = state.data.slice(start, start + state.size);

        let html = '';
        pageData.forEach((row, i) => {
            let stt = start + i + 1;
            if (type === 'Z7' || type === 'Z3') {
                html += `<tr><td>${stt}</td><td><b style="color:#c0392b">${row.Cell_name}</b></td><td>${getNetBadge(row.network)}</td><td style="color:#c0392b;font-weight:bold">${row.ratio || '>7'} ngày</td><td style="color:#e74c3c;font-weight:bold">${row.t0}</td><td style="color:#27ae60">${row.avgPast}</td><td style="text-align:center"><a href="/kpi-analytics?network=${row.network}&cell=${encodeURIComponent(row.Cell_name)}" target="_blank" class="btn-kpi">📊 Xem KPI</a></td></tr>`;
            } else if (type === 'Z1') {
                html += `<tr><td>${stt}</td><td><b style="color:#c0392b">${row.Cell_name}</b></td><td>${getNetBadge(row.network)}</td><td style="color:#e74c3c;font-weight:bold">${row.t0}</td><td style="color:#27ae60">${row.avgPast}</td><td style="text-align:center"><a href="/kpi-analytics?network=${row.network}&cell=${encodeURIComponent(row.Cell_name)}" target="_blank" class="btn-kpi">📊 Xem KPI</a></td></tr>`;
            } else if (type === 'DC') {
                let badge = row.ratio < 30 ? `background:#e74c3c; color:white;` : `background:#fbeeeeb0; color:#e74c3c; border:1px solid #fad2d2;`;
                html += `<tr><td>${stt}</td><td><b style="color:#c0392b">${row.Cell_name}</b></td><td>${getNetBadge(row.network)}</td><td>${row.t0}</td><td>${row.t7}</td><td><span style="padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; ${badge}">${row.ratio}%</span></td><td style="text-align:center"><a href="/kpi-analytics?network=${row.network}&cell=${encodeURIComponent(row.Cell_name)}" target="_blank" class="btn-kpi">📊 Xem KPI</a></td></tr>`;
            } else {
                let badge = row.ratio < 30 ? `background:#e74c3c; color:white;` : `background:#fbeeeeb0; color:#e74c3c; border:1px solid #fad2d2;`;
                html += `<tr><td>${stt}</td><td><b style="color:#2980b9">${row.POI}</b></td><td>${getNetBadge(row.network)}</td><td>${row.t0}</td><td>${row.t7}</td><td><span style="padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; ${badge}">${row.ratio}%</span></td><td style="text-align:center"><a href="/poi-report?poi=${encodeURIComponent(row.POI)}" target="_blank" class="btn-kpi" style="background:#27ae60;border-color:#219653">📈 Xem Báo Cáo POI</a></td></tr>`;
            }
        });
        tbody.innerHTML = html;
        renderPagination(type);
    }

    function renderPagination(type) {
        let state = T_STATE[type];
        const totalPages = Math.ceil(state.data.length / state.size);
        const controls = document.getElementById('pageControls' + type);
        controls.innerHTML = '';

        if (totalPages <= 1) return;

        controls.insertAdjacentHTML('beforeend', `<button class="btn-page" onclick="goToPage('${type}', ${state.page - 1})" ${state.page === 1 ? 'disabled' : ''}>&laquo;</button>`);
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= state.page - 1 && i <= state.page + 1)) {
                controls.insertAdjacentHTML('beforeend', `<button class="btn-page ${state.page === i ? 'active' : ''}" onclick="goToPage('${type}', ${i})">${i}</button>`);
            } else if (i === state.page - 2 || i === state.page + 2) {
                controls.insertAdjacentHTML('beforeend', `<span style="padding: 5px;">...</span>`);
            }
        }
        controls.insertAdjacentHTML('beforeend', `<button class="btn-page" onclick="goToPage('${type}', ${state.page + 1})" ${state.page === totalPages ? 'disabled' : ''}>&raquo;</button>`);
    }

    function goToPage(type, page) {
        let state = T_STATE[type];
        const totalPages = Math.ceil(state.data.length / state.size);
        if (page >= 1 && page <= totalPages) {
            state.page = page; renderTable(type);
            document.getElementById('tab' + type).querySelector('.table-wrapper').scrollTop = 0;
        }
    }

    function changePageSize(type) {
        T_STATE[type].size = parseInt(document.getElementById('size' + type).value);
        T_STATE[type].page = 1; renderTable(type);
    }

    function exportToExcel() {
        if (typeof XLSX === 'undefined') { alert('Đang tải Excel...'); return; }
        let wb = XLSX.utils.book_new();

        const exportTab = (type, sheetName) => {
            if(T_STATE[type].data.length === 0) return;
            let exportData = T_STATE[type].data.map((r,i) => {
                let row = { "STT": i+1, "Mạng": r.network ? r.network.toUpperCase() : '' };
                if (type === 'Z7' || type === 'Z3') {
                    row["Tên Cell"] = r.Cell_name; row["Số Ngày Mất"] = r.ratio; row["Hôm nay (GB)"] = parseFloat(r.t0); row["TB Lịch Sử (GB)"] = parseFloat(r.avgPast);
                } else if (type === 'Z1') {
                    row["Tên Cell"] = r.Cell_name; row["Hôm nay (GB)"] = parseFloat(r.t0); row["Hôm qua (GB)"] = parseFloat(r.avgPast);
                } else if (type === 'DC') {
                    row["Tên Cell"] = r.Cell_name; row["Hôm nay (GB)"] = parseFloat(r.t0); row["Tuần trước (GB)"] = parseFloat(r.t7); row["Tỷ lệ Đạt (%)"] = r.ratio;
                } else {
                    row["Tên POI"] = r.POI; row["Hôm nay (GB)"] = parseFloat(r.t0); row["Tuần trước (GB)"] = parseFloat(r.t7); row["Tỷ lệ Đạt (%)"] = r.ratio;
                }
                return row;
            });
            let ws = XLSX.utils.json_to_sheet(exportData);
            XLSX.utils.book_append_sheet(wb, ws, sheetName);
        };

        exportTab('Z7', "Zero_Lon_Hon_7_Ngay"); exportTab('Z3', "Zero_Tu_3_Den_6_Ngay"); exportTab('Z1', "Zero_1_Ngay");
        exportTab('DC', "Suy_Giam_Cell"); exportTab('DP', "Suy_Giam_POI");

        if(wb.SheetNames.length === 0) { alert("Không có dữ liệu để xuất"); return; }
        XLSX.writeFile(wb, `Bao_Cao_Traffic_Down_Mang_Luoi.xlsx`);
    }
</script>
</body>
</html>
