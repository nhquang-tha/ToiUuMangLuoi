
<%- include('partials/head') %>
<%
    let activeUser = locals.currentUser || locals.user || (typeof currentUser !== 'undefined' ? currentUser : null);
    let rawRole = activeUser && activeUser.role ? activeUser.role : '';
    let normalizedRole = rawRole ? String(rawRole).trim().toLowerCase() : '';
    let sidebarUser = activeUser ? Object.assign({}, activeUser, { role: normalizedRole }) : null;
%>
<style>
    .layout { display: flex; height: 100vh; overflow: hidden; background-color: #f4f6f8; }
    .main-content { flex: 1; overflow-y: auto; padding: 20px; position: relative; }
    
    .process-card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px; border-top: 4px solid #c0392b; }
    
    .steps-container { display: flex; gap: 15px; margin-bottom: 20px; flex-wrap: wrap; }
    .step-box { flex: 1; min-width: 200px; padding: 15px; border-radius: 8px; border: 1px solid #ecf0f1; background: #fdfdfd; position: relative; overflow: hidden;}
    .step-box::before { content:''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #3498db; }
    .step-box h4 { margin: 0 0 5px 0; color: #2c3e50; font-size: 14px;}
    .step-box p { margin: 0; font-size: 12px; color: #7f8c8d; line-height: 1.4; }
    
    .tab-header { display: flex; border-bottom: 2px solid #ecf0f1; margin-bottom: 20px; flex-wrap: wrap;}
    .tab-btn { background: transparent; border: none; padding: 12px 25px; cursor: pointer; font-size: 14px; font-weight: bold; color: #7f8c8d; transition: 0.3s; position: relative; }
    .tab-btn:hover { color: #2c3e50; }
    .tab-btn.active { color: #c0392b; border-bottom: 3px solid #c0392b; background: #fdf2f2;}
    .badge-count { position: absolute; top: 5px; right: 5px; background: #e74c3c; color: white; font-size: 10px; padding: 2px 6px; border-radius: 10px; }

    .tab-content { display: none; animation: fadeIn 0.4s; }
    .tab-content.active { display: block; }

    /* CẤU HÌNH BẢNG & PHÂN TRANG */
    .table-wrapper { width: 100%; max-height: 55vh; overflow-y: auto; overflow-x: auto; background: #fff; border: 1px solid #ecf0f1; border-radius: 8px 8px 0 0; }
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 12px; white-space: nowrap; }
    .data-table th, .data-table td { padding: 12px 15px; border-bottom: 1px solid #ecf0f1; text-align: center; }
    .data-table th { background-color: #f8f9fa; color: #2c3e50; font-weight: bold; font-size: 11px; text-transform: uppercase; position: sticky; top: 0; z-index: 10; box-shadow: 0 2px 2px -1px rgba(0,0,0,0.1); }
    .data-table tbody tr:hover td { background-color: #fdf2f2; }

    .cell-name { font-weight: 800; color: #2980b9; font-size: 13px; text-align: left !important;}
    .metric-val { font-weight: bold; }
    .val-bad { color: #e74c3c; }

    .status-select { padding: 6px; border-radius: 4px; border: 1px solid #bdc3c7; font-size: 11px; font-weight: bold; outline: none; cursor: pointer;}
    .status-Pending { background: #fdf2f2; color: #c0392b; border-color: #fad2d2; }
    .status-Processing { background: #fef5e7; color: #d35400; border-color: #fad7a1; }
    .status-Done { background: #e8f8f5; color: #27ae60; border-color: #bce8e0; }
    
    .note-input { width: 100%; padding: 6px 10px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 11px; outline: none; box-sizing: border-box; }
    .note-input:focus { border-color: #3498db; }

    #btnExport:hover { background: #219653 !important; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(39, 174, 96, 0.3) !important; }

    .pagination-bar { padding: 10px 15px; background: #f8f9fa; border: 1px solid #ecf0f1; border-top: none; border-radius: 0 0 8px 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
    .page-info select { padding: 4px 8px; border-radius: 4px; border: 1px solid #bdc3c7; outline: none; cursor: pointer; font-weight: bold;}
    .page-controls { display: flex; gap: 5px; }
    .btn-page { background: #fff; border: 1px solid #bdc3c7; padding: 4px 10px; border-radius: 4px; cursor: pointer; color: #34495e; font-weight: bold; transition: 0.2s;}
    .btn-page:hover:not(:disabled) { background: #c0392b; color: white; border-color: #c0392b; }
    .btn-page.active { background: #c0392b; color: white; border-color: #c0392b; }
    .btn-page:disabled { opacity: 0.5; cursor: not-allowed; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<div class="layout">
    <%- include('partials/sidebar', { currentUser: sidebarUser }) %>
    <main class="main-content">
        <header class="topbar">
            <h1>☢️ Cứu Hộ Điểm Đen Vô Tuyến (Bad Cells)</h1>
            <p style="margin: 5px 0 0 0; color: #7f8c8d; font-size: 13px;">Hệ thống tự động loại trừ hiện tượng đột biến 1-2 ngày, chỉ bóc tách các trạm suy hao mãn tính (Vi phạm ≥ 5/7 ngày).</p>
        </header>
        
        <div class="content-body">
            
            <div class="process-card">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
                    <h3 style="margin: 0; color: #c0392b;">🔄 Quy Trình Chuẩn 4 Bước (CEM Standard)</h3>
                    <button onclick="exportToExcel()" id="btnExport" style="background: #27ae60; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 13px; display: none; transition: 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                        📥 Xuất File Excel
                    </button>
                </div>
                
                <div class="steps-container">
                    <div class="step-box" style="border-left-color:#3498db;"><h4>1. Lọc Công Nghệ</h4><p>Thput < 15Mbps (4G) / 50Mbps (5G), PRB > 70%, CQI < 90%.</p></div>
                    <div class="step-box" style="border-left-color:#9b59b6;"><h4>2. Lọc Tần Suất</h4><p>Vi phạm 5/7 ngày. Tự động loại trừ trạm Blacklist (IBS, VSAT).</p></div>
                    <div class="step-box" style="border-left-color:#f39c12;"><h4>3. Ma Trận Ưu Tiên</h4><p>P1 (Cấp cứu QoE), P2 (Nghẽn PRB), P3 (Nhiễu CQI).</p></div>
                    <div class="step-box" style="border-left-color:#27ae60;"><h4>4. Đóng Vòng</h4><p>Hệ thống tự động theo dõi và clear lỗi nếu hết vi phạm.</p></div>
                </div>

                <div id="loadingMsg" style="text-align: center; padding: 30px; color: #e74c3c; font-size: 15px; font-weight: bold;">
                    <span style="display: inline-block; animation: spin 1s linear infinite;">⏳</span> Đang tải ma trận Bad Cells...
                </div>

                <div id="dashboardArea" style="display: none;">
                    <div style="font-weight:bold; color:#2c3e50; margin-bottom: 15px;">📅 Kỳ Đánh Giá Nghiệm Thu (Mới Nhất): <span id="latestDate" style="color:#e74c3c;"></span></div>
                    
                    <div class="tab-header">
                        <button class="tab-btn active" onclick="openTab(event, 'P1')">🚨 P1: Cấp Cứu QoE/Tốc Độ <span class="badge-count" id="countP1">0</span></button>
                        <button class="tab-btn" onclick="openTab(event, 'P2')">⚠️ P2: Giải Tỏa Nghẽn (PRB) <span class="badge-count" id="countP2" style="background:#e67e22;">0</span></button>
                        <button class="tab-btn" onclick="openTab(event, 'P3')">🔧 P3: Xử Lý Nhiễu (CQI) <span class="badge-count" id="countP3" style="background:#34495e;">0</span></button>
                    </div>

                    <!-- TAB P1 -->
                    <div id="tabP1" class="tab-content active">
                        <div style="padding: 10px 15px; background: #fdf2f2; color: #c0392b; border-left: 3px solid #e74c3c; margin-bottom: 15px; font-size: 12px; font-weight: bold;">Đội Truyền Dẫn / Vô Tuyến: Trạm Traffic cao nhưng tốc độ tải dưới 10 Mbps. Khách hàng phàn nàn trực tiếp.</div>
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead><tr><th style="text-align:left;">Tên Cell (Mạng)</th><th>Traffic<br>(TB 7 ngày)</th><th>Thput DL<br>(Kbps/Mbps)</th><th>Latency/Drop</th><th>Ngày Lỗi</th><th>Trạng Thái</th><th>Ghi Chú Xử Lý</th></tr></thead>
                                <tbody id="bodyP1"></tbody>
                            </table>
                        </div>
                        <div class="pagination-bar">
                            <div class="page-info">Hiển thị <select id="sizeP1" onchange="changePageSize('P1')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div>
                            <div class="page-controls" id="pageControlsP1"></div>
                        </div>
                    </div>

                    <!-- TAB P2 -->
                    <div id="tabP2" class="tab-content">
                        <div style="padding: 10px 15px; background: #fef5e7; color: #d35400; border-left: 3px solid #e67e22; margin-bottom: 15px; font-size: 12px; font-weight: bold;">Đội Tối Ưu (RNO): Trạm nghẽn PRB > 70%. Yêu cầu San tải (Load Balancing) hoặc cụp Downtilt để hất user.</div>
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead><tr><th style="text-align:left;">Tên Cell (Mạng)</th><th>Traffic<br>(TB 7 ngày)</th><th>PRB DL (%)</th><th>Thput DL<br>(Kbps/Mbps)</th><th>Ngày Lỗi</th><th>Trạng Thái</th><th>Ghi Chú Xử Lý</th></tr></thead>
                                <tbody id="bodyP2"></tbody>
                            </table>
                        </div>
                        <div class="pagination-bar">
                            <div class="page-info">Hiển thị <select id="sizeP2" onchange="changePageSize('P2')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div>
                            <div class="page-controls" id="pageControlsP2"></div>
                        </div>
                    </div>

                    <!-- TAB P3 -->
                    <div id="tabP3" class="tab-content">
                        <div style="padding: 10px 15px; background: #f4f6f8; color: #34495e; border-left: 3px solid #34495e; margin-bottom: 15px; font-size: 12px; font-weight: bold;">Đội UCTT Hiện Trường: Chất lượng kênh sóng CQI chạm đáy. Cần quét nhiễu ngoài, đo PIM, kiểm tra góc Azimuth.</div>
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead><tr><th style="text-align:left;">Tên Cell (Mạng)</th><th>CQI (%)</th><th>Drop Rate (%)</th><th>Thput DL<br>(Kbps/Mbps)</th><th>Ngày Lỗi</th><th>Trạng Thái</th><th>Ghi Chú Xử Lý</th></tr></thead>
                                <tbody id="bodyP3"></tbody>
                            </table>
                        </div>
                        <div class="pagination-bar">
                            <div class="page-info">Hiển thị <select id="sizeP3" onchange="changePageSize('P3')"><option value="10">10</option><option value="20" selected>20</option><option value="50">50</option></select> dòng</div>
                            <div class="page-controls" id="pageControlsP3"></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const xlsxScript = document.createElement('script');
        xlsxScript.src = atob('aHR0cHM6Ly91bnBrZy5jb20veGxzeC9kaXN0L3hsc3guZnVsbC5taW4uanM=');
        document.head.appendChild(xlsxScript);
    });

    // State quản lý 3 Tab riêng biệt
    const P_STATE = {
        'P1': { data: [], page: 1, size: 20 },
        'P2': { data: [], page: 1, size: 20 },
        'P3': { data: [], page: 1, size: 20 }
    };

    window.badCellsData = []; // Full Data

    function openTab(evt, tabId) {
        let i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) tabcontent[i].classList.remove("active");
        tablinks = document.getElementsByClassName("tab-btn");
        for (i = 0; i < tablinks.length; i++) tablinks[i].classList.remove("active");
        document.getElementById('tab' + tabId).classList.add("active");
        evt.currentTarget.classList.add("active");
    }

    async function loadBadCells() {
        try {
            const res = await fetch('/api/bad-cells-data');
            const result = await res.json();
            document.getElementById('loadingMsg').style.display = 'none';

            if (!result.data || result.data.length === 0) {
                document.getElementById('dashboardArea').innerHTML = '<div style="text-align:center; padding: 40px; color: #27ae60; font-size: 16px; font-weight:bold;">🎉 Tuyệt vời! Toàn bộ mạng lưới không có Điểm Đen vô tuyến nào trong ngày mới nhất!</div>';
                document.getElementById('dashboardArea').style.display = 'block'; return;
            }

            window.badCellsData = result.data;
            document.getElementById('latestDate').innerText = result.latestDate;
            document.getElementById('dashboardArea').style.display = 'block';
            document.getElementById('btnExport').style.display = 'block'; 

            // Phân loại data vào State
            P_STATE['P1'].data = result.data.filter(r => r.priority === 'P1');
            P_STATE['P2'].data = result.data.filter(r => r.priority === 'P2');
            P_STATE['P3'].data = result.data.filter(r => r.priority === 'P3');

            document.getElementById('countP1').innerText = P_STATE['P1'].data.length;
            document.getElementById('countP2').innerText = P_STATE['P2'].data.length;
            document.getElementById('countP3').innerText = P_STATE['P3'].data.length;

            renderTable('P1'); renderTable('P2'); renderTable('P3');
        } catch (e) { document.getElementById('loadingMsg').innerHTML = '❌ Lỗi tải dữ liệu từ máy chủ.'; }
    }

    const makeSelect = (id, currentStatus) => {
        let cls = `status-${currentStatus}`;
        return `<select class="status-select ${cls}" onchange="updateStatus(${id}, this)">
            <option value="Pending" ${currentStatus === 'Pending' ? 'selected' : ''}>🔴 Pending</option>
            <option value="Processing" ${currentStatus === 'Processing' ? 'selected' : ''}>🟡 Processing</option>
            <option value="Done" ${currentStatus === 'Done' ? 'selected' : ''}>🟢 Done</option>
        </select>`;
    };

    const makeNote = (id, note) => {
        return `<input type="text" class="note-input" value="${note || ''}" placeholder="Gõ xong ấn Enter..." onchange="updateNote(${id}, this.value)">`;
    };

    function renderTable(type) {
        const tbody = document.getElementById('body' + type);
        tbody.innerHTML = '';
        
        let state = P_STATE[type];
        const start = (state.page - 1) * state.size;
        const end = start + state.size;
        const pageData = state.data.slice(start, end);

        let html = '';
        pageData.forEach(r => {
            let netBadge = r.network === '5g' ? `<span style="background:#e8f8f5; color:#16a085; padding:2px 5px; border-radius:3px; font-size:10px; margin-left:5px;">5G</span>` : `<span style="background:#f4ecf8; color:#8e44ad; padding:2px 5px; border-radius:3px; font-size:10px; margin-left:5px;">4G</span>`;
            let cellHtml = `<td class="cell-name">${r.cell_name} ${netBadge}</td>`;
            
            if (type === 'P1') {
                html += `<tr>${cellHtml}<td>${r.avg_traffic.toFixed(1)}</td><td class="metric-val val-bad">${r.avg_thput.toFixed(1)}</td><td>${r.network === '4g' ? r.avg_latency.toFixed(1) + ' ms' : r.avg_drop.toFixed(2) + ' %'}</td><td><b style="color:#c0392b">${r.violation_days}/7</b> ngày</td><td>${makeSelect(r.id, r.status)}</td><td>${makeNote(r.id, r.action_note)}</td></tr>`;
            } else if (type === 'P2') {
                html += `<tr>${cellHtml}<td>${r.avg_traffic.toFixed(1)}</td><td class="metric-val val-bad">${r.avg_prb.toFixed(1)}</td><td>${r.avg_thput.toFixed(1)}</td><td><b style="color:#c0392b">${r.violation_days}/7</b> ngày</td><td>${makeSelect(r.id, r.status)}</td><td>${makeNote(r.id, r.action_note)}</td></tr>`;
            } else {
                html += `<tr>${cellHtml}<td class="metric-val val-bad">${r.avg_cqi.toFixed(1)}</td><td>${r.avg_drop.toFixed(2)}</td><td>${r.avg_thput.toFixed(1)}</td><td><b style="color:#c0392b">${r.violation_days}/7</b> ngày</td><td>${makeSelect(r.id, r.status)}</td><td>${makeNote(r.id, r.action_note)}</td></tr>`;
            }
        });
        tbody.innerHTML = html;
        renderPagination(type);
    }

    function renderPagination(type) {
        let state = P_STATE[type];
        const totalPages = Math.ceil(state.data.length / state.size);
        const controls = document.getElementById('pageControls' + type);
        controls.innerHTML = '';

        if (totalPages <= 1) return;

        controls.insertAdjacentHTML('beforeend', `<button class="btn-page" onclick="goToPage('${type}', ${state.page - 1})" ${state.page === 1 ? 'disabled' : ''}>&laquo;</button>`);
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= state.page - 1 && i <= state.page + 1)) {
                controls.insertAdjacentHTML('beforeend', `<button class="btn-page ${state.page === i ? 'active' : ''}" onclick="goToPage('${type}', ${i})">${i}</button>`);
            } else if (i === state.page - 2 || i === state.page + 2) {
                controls.insertAdjacentHTML('beforeend', `<span style="padding: 5px;">...</span>`);
            }
        }
        controls.insertAdjacentHTML('beforeend', `<button class="btn-page" onclick="goToPage('${type}', ${state.page + 1})" ${state.page === totalPages ? 'disabled' : ''}>&raquo;</button>`);
    }

    function goToPage(type, page) {
        let state = P_STATE[type];
        const totalPages = Math.ceil(state.data.length / state.size);
        if (page >= 1 && page <= totalPages) {
            state.page = page;
            renderTable(type);
            document.getElementById('tab' + type).querySelector('.table-wrapper').scrollTop = 0;
        }
    }

    function changePageSize(type) {
        P_STATE[type].size = parseInt(document.getElementById('size' + type).value);
        P_STATE[type].page = 1;
        renderTable(type);
    }

    async function updateStatus(id, selectEl) {
        let newStatus = selectEl.value; selectEl.className = `status-select status-${newStatus}`;
        let rowData = window.badCellsData.find(r => r.id === id); if(rowData) rowData.status = newStatus;
        await pushUpdate(id, newStatus, selectEl.closest('tr').querySelector('.note-input').value);
    }
    async function updateNote(id, newNote) {
        let status = document.querySelector(`select[onchange="updateStatus(${id}, this)"]`).value;
        let rowData = window.badCellsData.find(r => r.id === id); if(rowData) rowData.action_note = newNote;
        await pushUpdate(id, status, newNote);
    }
    async function pushUpdate(id, status, note) {
        try { await fetch('/api/bad-cells-update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id, status: status, action_note: note }) }); } catch (e) { alert("Lỗi mạng!"); }
    }

    function exportToExcel() {
        if (typeof XLSX === 'undefined') { alert('Đang tải thư viện Excel...'); return; }
        if (!window.badCellsData || window.badCellsData.length === 0) return;

        let exportData = window.badCellsData.map((r, i) => ({
            "STT": i + 1, "Tên Cell": r.cell_name, "Mạng": (r.network || '').toUpperCase(),
            "Mức Độ": r.priority, "Ngày Cập Nhật": r.latest_date, "Vi Phạm": r.violation_days + '/7',
            "TB Traffic": r.avg_traffic ? Number(r.avg_traffic.toFixed(2)) : 0,
            "TB Throughput": r.avg_thput ? Number(r.avg_thput.toFixed(2)) : 0,
            "TB PRB DL": r.avg_prb ? Number(r.avg_prb.toFixed(2)) : 0,
            "TB CQI": r.avg_cqi ? Number(r.avg_cqi.toFixed(2)) : 0,
            "Trạng Thái": r.status || 'Pending', "Ghi Chú Xử Lý": r.action_note || ''
        }));
        let ws = XLSX.utils.json_to_sheet(exportData); let wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Bad_Cells_Report");
        XLSX.writeFile(wb, `Bao_Cao_Bad_Cells_${window.badCellsData[0].latest_date.replace(/\//g, '_')}.xlsx`);
    }

    window.onload = loadBadCells;
</script>
</body>
</html>
