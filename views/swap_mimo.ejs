<%- include('partials/head') %>
<%
    let activeUser = locals.currentUser || locals.user || (typeof currentUser !== 'undefined' ? currentUser : null);
    let rawRole = activeUser && activeUser.role ? activeUser.role : '';
    let normalizedRole = rawRole ? String(rawRole).trim().toLowerCase() : '';
    let sidebarUser = activeUser ? Object.assign({}, activeUser, { role: normalizedRole }) : null;
%>
<style>
    .layout { display: flex; height: 100vh; overflow: hidden; background-color: #f4f6f8; }
    .main-content { flex: 1; overflow-y: auto; padding: 20px; }
    .topbar { margin-bottom: 20px; border-bottom: 2px solid #e0e6ed; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
    .topbar h1 { margin: 0; color: #2c3e50; font-size: 24px; font-weight: bold; }
    
    .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 20px; }
    
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px; }
    .filter-box { background: #f8f9fa; padding: 12px; border-radius: 6px; border: 1px solid #ecf0f1; border-left: 4px solid #3498db; }
    .filter-box.red { border-left-color: #e74c3c; }
    .filter-box.green { border-left-color: #27ae60; }
    
    .filter-box label { font-size: 12px; font-weight: bold; color: #7f8c8d; display: block; margin-bottom: 5px; text-transform: uppercase; }
    .filter-box input { width: 100%; padding: 8px; border: 1px solid #bdc3c7; border-radius: 4px; outline: none; font-weight: bold; color: #2c3e50; }

    .btn-run { background: #8e44ad; color: white; border: none; padding: 12px 25px; font-size: 14px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: 0.2s; width: 100%; }
    .btn-run:hover { background: #732d91; transform: translateY(-1px); }

    .data-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 10px; }
    .data-table th, .data-table td { padding: 10px; border: 1px solid #ecf0f1; text-align: center; }
    .data-table th { background-color: #f1f4f6; color: #2c3e50; font-weight: bold; }
    .data-table tr:hover { background-color: #f9fbfd; }

    .cell-up { font-weight: bold; color: #e74c3c; background: rgba(231, 76, 60, 0.05); }
    .cell-down { font-weight: bold; color: #27ae60; background: rgba(39, 174, 96, 0.05); }
    .dist-badge { background: #f39c12; color: white; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; }

    #loadingMsg { display: none; text-align: center; padding: 30px; font-size: 16px; font-weight: bold; color: #8e44ad; }
    .stats-bar { display: flex; gap: 20px; margin-bottom: 15px; font-size: 14px; font-weight: bold; color: #34495e; }
    .stats-bar span { padding: 6px 12px; background: #eee; border-radius: 6px; }

    /* [MỚI] CSS Custom Dropdown Checkbox */
    .multi-select-container { position: relative; width: 100%; }
    .multi-select-header { padding: 8px 10px; border: 1px solid #bdc3c7; border-radius: 4px; background: #fff; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: bold; color: #2c3e50; font-size: 12px; height: 35px; box-sizing: border-box;}
    .multi-select-dropdown { position: absolute; top: 100%; left: 0; width: 100%; max-height: 250px; overflow-y: auto; background: #fff; border: 1px solid #bdc3c7; border-top: none; border-radius: 0 0 4px 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); z-index: 100; display: none; }
    .multi-select-dropdown.show { display: block; }
    .multi-select-option { display: flex; align-items: center; padding: 8px 10px; cursor: pointer; font-size: 12px; transition: background 0.2s; color: #34495e; }
    .multi-select-option:hover { background: #f1f4f6; }
    .multi-select-option input { margin-right: 8px; cursor: pointer; width: 14px; height: 14px; accent-color: #f39c12;}
</style>

<div class="layout">
    <%- include('partials/sidebar', { currentUser: sidebarUser }) %>
    <main class="main-content">
        <header class="topbar">
            <h1>🔄 Đề Xuất SWAP MIMO (L1800)</h1>
            <button class="btn-run" onclick="exportToExcel()" id="btnExport" style="display:none; width:auto; background:#27ae60;">📥 Xuất Excel</button>
        </header>
        
        <div class="card">
            <h4 style="margin-top:0; color:#2c3e50;">⚙️ Cấu Hình Tiêu Chí Lọc (Trung bình 30 Ngày)</h4>
            <div class="filter-grid">
                <div class="filter-box red">
                    <label>UP: Nâng cấp (2T->4T) | Traffic > (GB)</label>
                    <input type="number" id="upTraf" value="80">
                </div>
                <div class="filter-box red">
                    <label>UP: Kẹt Tốc độ | Thput DL < (Mbps)</label>
                    <input type="number" id="upThput" value="15">
                </div>
                <div class="filter-box green">
                    <label>DOWN: Hạ cấp (4T->2T) | Traffic < (GB)</label>
                    <input type="number" id="downTraf" value="20">
                </div>
                <div class="filter-box green">
                    <label>DOWN: Lãng phí | PRB < (%)</label>
                    <input type="number" id="downPrb" value="15">
                </div>
                <div class="filter-box" style="border-left-color:#f39c12;">
                    <label>Quận/Huyện Lựa Chọn</label>
                    <div class="multi-select-container">
                        <div class="multi-select-header" onclick="toggleDistrictDropdown()">
                            <span id="districtSelectedText">TẤT CẢ QUẬN/HUYỆN</span>
                            <span style="font-size: 10px;">▼</span>
                        </div>
                        <div class="multi-select-dropdown" id="districtDropdown">
                            <label class="multi-select-option" style="border-bottom: 1px solid #eee; background: #fafafa;">
                                <input type="checkbox" id="cb_dist_all" value="ALL" checked onchange="toggleAllDistricts(this)">
                                <strong>-- TẤT CẢ QUẬN/HUYỆN --</strong>
                            </label>
                            <div id="districtListContainer">
                                <!-- Checkbox sẽ được JavaScript đổ vào đây -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn-run" onclick="runAlgorithm()">🚀 KÍCH HOẠT THUẬT TOÁN GHÉP CẶP 1-1</button>
        </div>

        <div id="loadingMsg">
            <span style="display: inline-block; animation: spin 1s linear infinite;">🔄</span> Đang tính toán ma trận khoảng cách và phân tích Data 30 ngày...
        </div>

        <div id="resultArea" class="card" style="display: none;">
            <div class="stats-bar" id="statsBar"></div>
            <div style="overflow-x: auto;">
                <table class="data-table" id="swapTable">
                    <thead>
                        <tr>
                            <th rowspan="2">Khoảng Cách</th>
                            <th colspan="5" style="background: #fadbd8; color: #c0392b;">🚨 TRẠM CẦN NÂNG CẤP (Tháo 2T2R -> Lắp 4T4R)</th>
                            <th colspan="3" style="background: #d5f5e3; color: #27ae60;">📉 TRẠM DƯ THỪA TÀI NGUYÊN (Tháo 4T4R -> Lắp 2T2R)</th>
                        </tr>
                        <tr>
                            <th style="background: #fdf2f2;">Cell Name</th>
                            <th style="background: #fdf2f2;">MIMO H/tại</th>
                            <th style="background: #fdf2f2;">Traffic (GB)</th>
                            <th style="background: #fdf2f2;">Thput (Mbps)</th>
                            <th style="background: #fdf2f2;">QoE / QoS</th>
                            <th style="background: #eaab9;">Cell Name</th>
                            <th style="background: #eaab9;">MIMO H/tại</th>
                            <th style="background: #eaab9;">Traffic (GB)</th>
                            <th style="background: #eaab9;">PRB (%)</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
    // Logic Mở/Đóng Dropdown
    function toggleDistrictDropdown() {
        document.getElementById('districtDropdown').classList.toggle('show');
    }

    // Tự động đóng dropdown khi click ra ngoài
    document.addEventListener('click', function(event) {
        const container = document.querySelector('.multi-select-container');
        if (container && !container.contains(event.target)) {
            document.getElementById('districtDropdown').classList.remove('show');
        }
    });

    // Check All / Uncheck All
    function toggleAllDistricts(cbAll) {
        const checkboxes = document.querySelectorAll('.cb-dist-item');
        checkboxes.forEach(cb => cb.checked = cbAll.checked);
        updateDistrictSelectedText();
    }

    // Đánh dấu lại nút ALL nếu tick thủ công đủ tất cả
    function checkDistrictSelection() {
        const checkboxes = document.querySelectorAll('.cb-dist-item');
        const cbAll = document.getElementById('cb_dist_all');
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        cbAll.checked = allChecked;
        updateDistrictSelectedText();
    }

    // Cập nhật text hiển thị trên Header của Dropdown
    function updateDistrictSelectedText() {
        const checkboxes = document.querySelectorAll('.cb-dist-item:checked');
        const cbAll = document.getElementById('cb_dist_all');
        const textSpan = document.getElementById('districtSelectedText');
        
        if (cbAll.checked || checkboxes.length === document.querySelectorAll('.cb-dist-item').length) {
            textSpan.innerText = 'TẤT CẢ QUẬN/HUYỆN';
            textSpan.style.color = '#2c3e50';
        } else if (checkboxes.length === 0) {
            textSpan.innerText = '⚠️ Chưa chọn khu vực';
            textSpan.style.color = '#e74c3c';
        } else if (checkboxes.length <= 2) {
            textSpan.innerText = Array.from(checkboxes).map(cb => cb.value).join(', ');
            textSpan.style.color = '#d35400';
        } else {
            textSpan.innerText = `Đã chọn ${checkboxes.length} khu vực`;
            textSpan.style.color = '#d35400';
        }
    }

    // Tự động tải danh sách Quận/Huyện và render dạng Checkbox
    document.addEventListener('DOMContentLoaded', async () => {
        try {
            const res = await fetch('/api/districts');
            const dists = await res.json();
            const container = document.getElementById('districtListContainer');
            dists.forEach(d => {
                if(d) {
                    let html = `
                        <label class="multi-select-option">
                            <input type="checkbox" class="cb-dist-item" value="${d}" checked onchange="checkDistrictSelection()">
                            ${d}
                        </label>
                    `;
                    container.insertAdjacentHTML('beforeend', html);
                }
            });
            updateDistrictSelectedText(); // Khởi tạo text hiển thị
        } catch(e) { console.log("Không tải được danh sách Quận/Huyện."); }
    });

    async function runAlgorithm() {
        document.getElementById('loadingMsg').style.display = 'block';
        document.getElementById('resultArea').style.display = 'none';
        document.getElementById('btnExport').style.display = 'none';
        
        const upTraf = document.getElementById('upTraf').value;
        const upThput = document.getElementById('upThput').value;
        const downTraf = document.getElementById('downTraf').value;
        const downPrb = document.getElementById('downPrb').value;
        
        // Lấy danh sách Quận/Huyện từ các Checkbox đã đánh dấu tick
        let districts = 'ALL';
        if (!document.getElementById('cb_dist_all').checked) {
            const checkedBoxes = document.querySelectorAll('.cb-dist-item:checked');
            districts = Array.from(checkedBoxes).map(cb => cb.value).join(',');
            
            if (districts === '') {
                alert('Vui lòng chọn ít nhất 1 Quận/Huyện để quét.');
                document.getElementById('loadingMsg').style.display = 'none';
                return;
            }
        }

        try {
            const res = await fetch(`/api/swap-mimo?upTraf=${upTraf}&upThput=${upThput}&downTraf=${downTraf}&downPrb=${downPrb}&districts=${encodeURIComponent(districts)}`);
            const data = await res.json();
            
            document.getElementById('loadingMsg').style.display = 'none';
            if(data.error) {
                alert(data.error); return;
            }

            document.getElementById('statsBar').innerHTML = `
                <span style="color:#8e44ad">📅 Quét: ${data.daysAnalyzed} ngày</span>
                <span style="color:#c0392b">🚨 Phát hiện: ${data.stats.totalUpgradesFound} Cell cần nâng</span>
                <span style="color:#27ae60">📉 Phát hiện: ${data.stats.totalDowngradesFound} Cell dư thừa</span>
                <span style="color:#f39c12; background:#fef5e7; border: 1px solid #f39c12;">🤝 Đã ghép thành công: ${data.stats.totalPairsMatched} Cặp Swap</span>
            `;

            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            if (data.pairs.length > 0) {
                data.pairs.forEach(pair => {
                    const up = pair.upgrade;
                    const down = pair.downgrade;
                    
                    let tr = `
                        <tr>
                            <td><span class="dist-badge">${pair.distance} Km</span></td>
                            
                            <td class="cell-up">${up.cell}</td>
                            <td style="background: rgba(231, 76, 60, 0.02);">${up.mimo}</td>
                            <td style="background: rgba(231, 76, 60, 0.02); color:#c0392b; font-weight:bold;">${parseFloat(up.traf).toFixed(1)}</td>
                            <td style="background: rgba(231, 76, 60, 0.02); color:#c0392b;">${parseFloat(up.thput).toFixed(1)}</td>
                            <td style="background: rgba(231, 76, 60, 0.02);">${up.cem} / ${up.qos}</td>
                            
                            <td class="cell-down">${down.cell}</td>
                            <td style="background: rgba(39, 174, 96, 0.02);">${down.mimo}</td>
                            <td style="background: rgba(39, 174, 96, 0.02); color:#27ae60; font-weight:bold;">${parseFloat(down.traf).toFixed(1)}</td>
                            <td style="background: rgba(39, 174, 96, 0.02); color:#27ae60;">${parseFloat(down.prb).toFixed(1)}%</td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', tr);
                });
                
                document.getElementById('resultArea').style.display = 'block';
                document.getElementById('btnExport').style.display = 'block';
            } else {
                tbody.innerHTML = `<tr><td colspan="10" style="padding: 30px; font-weight:bold; color:#7f8c8d;">Không tìm thấy cặp Swap nào thỏa mãn các điều kiện cấu hình. Vui lòng nới lỏng khoảng cách hoặc thông số!</td></tr>`;
                document.getElementById('resultArea').style.display = 'block';
            }

        } catch (error) {
            alert("Lỗi kết nối Server.");
            document.getElementById('loadingMsg').style.display = 'none';
        }
    }

    function exportToExcel() {
        let wb = XLSX.utils.table_to_book(document.getElementById('swapTable'), {sheet: "De_Xuat_Swap"});
        XLSX.writeFile(wb, "Bao_Cao_Swap_MIMO_1800.xlsx");
    }
</script>
</body>
</html>
