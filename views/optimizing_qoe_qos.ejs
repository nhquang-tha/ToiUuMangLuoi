<%- include('partials/head') %>
<%
    let activeUser = locals.currentUser || locals.user || (typeof currentUser !== 'undefined' ? currentUser : null);
    let rawRole = activeUser && activeUser.role ? activeUser.role : '';
    let normalizedRole = rawRole ? String(rawRole).trim().toLowerCase() : '';
    let sidebarUser = activeUser ? Object.assign({}, activeUser, { role: normalizedRole }) : null;
%>
<style>
    .layout { display: flex; height: 100vh; overflow: hidden; background-color: #f4f6f8; }
    .main-content { flex: 1; overflow-y: auto; padding: 20px; position: relative; }
    
    .filter-card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px; border-left: 6px solid #2980b9;}
    
    .step-badge { background: #2c3e50; color: white; padding: 5px 12px; border-radius: 6px; font-size: 13px; font-weight: bold; margin-bottom: 12px; display: inline-block; letter-spacing: 0.5px;}
    .step-desc { font-size: 14px; color: #34495e; margin-bottom: 15px; line-height: 1.6;}
    .step-desc ul { margin: 8px 0 0 20px; padding: 0; }
    .step-desc li { margin-bottom: 6px; }

    .group-card { background: white; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); margin-bottom: 30px; overflow: hidden; border: 1px solid #ecf0f1; display: none; animation: fadeIn 0.5s;}
    .group-header { padding: 15px 20px; font-weight: bold; color: white; font-size: 16px; display: flex; justify-content: space-between; align-items: center; text-transform: uppercase;}
    
    .group-header.g1 { background: #8e44ad; } /* Truyền dẫn */
    .group-header.g2 { background: #e74c3c; } /* Vô tuyến */
    .group-header.g3 { background: #f39c12; } /* Nghẽn */
    
    .action-box { padding: 15px 20px; background: #fdfdfd; border-bottom: 1px solid #ecf0f1; font-size: 13.5px; line-height: 1.6; color: #2c3e50;}
    .action-box ul { margin: 8px 0 0 20px; padding: 0; }
    .action-box li { margin-bottom: 6px; }
    .action-badge { background: #27ae60; color: white; font-weight: bold; padding: 4px 10px; border-radius: 4px; font-size: 12px; margin-right: 5px; }

    /* Nâng cấp Bảng: Thanh cuộn đa chiều và Header cố định */
    .table-wrapper { width: 100%; max-height: 400px; overflow: auto; background: #fff; border-bottom: 1px solid #ecf0f1;}
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; white-space: nowrap; }
    .data-table th, .data-table td { padding: 12px 15px; border-bottom: 1px solid #ecf0f1; text-align: left; }
    .data-table th { background-color: #f8f9fa; color: #2c3e50; font-size: 12px; position: sticky; top: 0; z-index: 10; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .data-table tbody tr:hover { background-color: #fdf2f2; }

    .metric-bad { color: #e74c3c; font-weight: bold; background: #fdf2f2; padding: 3px 8px; border-radius: 4px; border: 1px solid #fad2d2;}

    .btn-kpi { background: #3498db; color: white; padding: 8px 12px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: bold; transition: 0.2s; border: none; display: inline-block;}
    .btn-kpi:hover { background: #2980b9; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(52, 152, 219, 0.3); }

    .summary-box { background: #e8f8f5; border: 1px solid #27ae60; padding: 20px; border-radius: 8px; margin-bottom: 25px; display: none; line-height: 1.6; font-size: 14.5px; color: #2c3e50;}
    .summary-box span { font-weight: bold; color: #27ae60; font-size: 18px;}

    /* Style Phân trang (Pagination) */
    .table-toolbar { padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ecf0f1; background: #fafbfc; }
    .page-size-select { padding: 5px 10px; border-radius: 4px; border: 1px solid #bdc3c7; outline: none; font-size: 13px; font-weight: bold; color: #34495e; cursor: pointer; margin-left: 8px;}
    .page-btn { padding: 6px 12px; border: 1px solid #bdc3c7; background: white; color: #2c3e50; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: bold; transition: 0.2s; }
    .page-btn:hover:not(:disabled) { background: #3498db; color: white; border-color: #3498db; }
    .page-btn:disabled { background: #ecf0f1; color: #95a5a6; cursor: not-allowed; border-color: #dcdde1; }
    .page-info-badge { padding: 6px 12px; font-size: 13px; font-weight: bold; background: #ecf0f1; border-radius: 4px; color: #2c3e50; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<div class="layout">
    <%- include('partials/sidebar', { currentUser: sidebarUser }) %>
    <main class="main-content">
        <header class="topbar">
            <h1>🛠️ Tối Ưu CEM/QoS (Quy Trình Phễu Lọc RNO 5 Bước)</h1>
        </header>
        
        <div class="content-body">
            
            <!-- BƯỚC 1 & 2 -->
            <div class="filter-card">
                <div class="step-badge">BƯỚC 1: NHẬN DIỆN SÀNG LỌC & BƯỚC 2: QUY TẮC 5/7</div>
                <div class="step-desc">
                    Hệ thống sẽ chạy một luồng <b>Phễu Lọc Đa Tầng (Multi-layer Filtering)</b> có độ nhiễu bằng 0:
                    <ul>
                        <li><b>Tội phạm kép:</b> Chỉ lấy các điểm giao thoa nguy hiểm nhất (<span style="color:#e74c3c; font-weight:bold;">CEM < 4</span> VÀ <span style="color:#e74c3c; font-weight:bold;">QoS < 4</span>).</li>
                        <li><b>Lọc Rác (False Positive):</b> Gạt ngay các trạm lưu lượng siêu thấp (Traffic < 5GB hoặc UE < 30) để không làm lãng phí nguồn lực kỹ sư.</li>
                        <li><b>Miễn trừ Pháp lý:</b> Áp dụng tự động VLOOKUP để loại bỏ Blacklist IBS cũ, Hải đảo, Biên giới.</li>
                        <li><b>Bệnh mãn tính:</b> Loại bỏ lỗi đứt cáp tạm thời, chỉ giữ lại Cell vi phạm chỉ số trong 5/7 ngày gần nhất.</li>
                    </ul>
                </div>
                
                <div style="display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; margin-top: 25px;">
                    <div style="flex: 1; min-width: 250px;">
                        <label style="display:block; margin-bottom:8px; font-weight:bold; color:#2980b9;">Đầu Vào: Báo Cáo Đánh Giá (Tuần):</label>
                        <select id="weekSelect" style="width: 100%; padding: 12px; border: 1px solid #bdc3c7; border-radius: 6px; outline: none; cursor: pointer; font-size: 14px;">
                            <% if (typeof weeks !== 'undefined' && weeks.length > 0) { %>
                                <% weeks.forEach(w => { %>
                                    <option value="<%= w %>"><%= w %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="Current">Dữ liệu Tuần Hiện Tại (Tự động)</option>
                            <% } %>
                        </select>
                    </div>
                    <div style="flex: 1; min-width: 250px; padding: 12px; background: #f8f9fa; border-radius: 6px; border: 1px solid #ecf0f1; display: flex; align-items: center; height: 46px; box-sizing: border-box;">
                        <label style="display:flex; align-items: center; cursor: pointer; font-weight: bold; color: #34495e; margin: 0;">
                            <input type="checkbox" id="blacklistCheck" checked style="width: 18px; height: 18px; margin-right: 10px;">
                            Kích hoạt màng lọc Blacklist
                        </label>
                    </div>
                    
                    <button onclick="runOptimization()" class="btn-primary" style="background: #2980b9; color: white; border: none; padding: 0 30px; border-radius: 6px; font-weight: bold; cursor: pointer; height: 46px; font-size: 14px; transition: 0.2s;">
                        ⚙️ Khởi Chạy Phễu Lọc
                    </button>
                    <button onclick="exportToExcel()" id="btnExport" class="btn-success" style="display: none; background: #27ae60; color: white; border: none; padding: 0 20px; border-radius: 6px; font-weight: bold; cursor: pointer; height: 46px; font-size: 14px; transition: 0.2s;">
                        📥 Xuất File Excel
                    </button>
                </div>
            </div>

            <!-- THÔNG BÁO -->
            <div id="loadingMsg" style="display: none; text-align: center; padding: 30px; color: #2980b9; font-size: 16px; font-weight: bold; background: white; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 25px;">
                <span style="display: inline-block; animation: spin 1s linear infinite;">⏳</span> Đang thực thi Phễu lọc, ánh xạ KPI 7 ngày và phân bổ Ma trận...
            </div>
            <div id="errorMsg" style="display: none; text-align: center; padding: 20px; color: #e74c3c; font-weight: bold; background: #fdf2f2; border: 1px solid #fad2d2; border-radius: 8px; margin-bottom: 25px;"></div>

            <div id="summaryBox" class="summary-box">
                <b>BÁO CÁO PHỄU LỌC:</b> Có <span id="sumTotal">0</span> trạm "Tội phạm kép" (Cả CEM và QoS đều < 4 sao). 
                Đã gạt bỏ <span id="sumBlack">0</span> trạm Blacklist và loại trừ <span id="sumLow">0</span> trạm "Rác lưu lượng" (Traffic thấp). 
                Còn lại chính xác <span id="sumValid">0</span> trạm thực sự cần thiết phải ra quyết định tối ưu theo Ma trận.
            </div>

            <!-- BƯỚC 5: NHÓM TRUYỀN DẪN -->
            <div class="group-card" id="group1">
                <div class="group-header g1">
                    <div>MA TRẬN CẤP CỨU: NHÓM TRUYỀN DẪN (Tốc độ rùa bò + Trễ cao + PRB < 50%)</div>
                    <div>Cần Xử Lý: <b id="g1Count" style="font-size: 18px;">0</b></div>
                </div>
                <div class="action-box">
                    <span class="action-badge">BƯỚC 5: ACTION</span> <b>Đầu mối: Đội Truyền dẫn / NOC</b>
                    <ul>
                        <li>Đo kiểm luồng quang, kiểm tra lỗi SFP, rà soát cấu hình Router/Switch tại trạm (Sóng rỗi nhưng mạng chậm do nghẽn Backhaul).</li>
                        <li><b>Giám sát Đóng Vòng:</b> Theo dõi độ trễ (Latency) trong T+1, T+2 có giảm xuống dưới 50ms không.</li>
                    </ul>
                </div>
                <!-- Thanh công cụ phân trang Nhóm 1 -->
                <div class="table-toolbar">
                    <label style="font-size: 13px; font-weight: bold; color: #34495e;">
                        Hiển thị 
                        <select class="page-size-select" onchange="changePageSize(1, this)">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select> dòng/trang
                    </label>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Cell</th>
                                <th>Thput DL<br><small style="color:#7f8c8d">< 15 Mbps</small></th>
                                <th>Latency<br><small style="color:#7f8c8d">> 50 ms</small></th>
                                <th>PRB DL<br><small style="color:#7f8c8d">< 50%</small></th>
                                <th style="text-align: center;">CLOSED-LOOP VERIFICATION</th>
                            </tr>
                        </thead>
                        <tbody id="g1Body"></tbody>
                    </table>
                </div>
                <div id="pagination1"></div>
            </div>

            <!-- BƯỚC 5: NHÓM VÔ TUYẾN -->
            <div class="group-card" id="group2">
                <div class="group-header g2">
                    <div>MA TRẬN CẤP CỨU: NHÓM VÔ TUYẾN & THIẾT BỊ (CQI < 90% + Drop > 1%)</div>
                    <div>Cần Xử Lý: <b id="g2Count" style="font-size: 18px;">0</b></div>
                </div>
                <div class="action-box">
                    <span class="action-badge">BƯỚC 5: ACTION</span> <b>Đầu mối: Đội RNO / Đội Hiện trường (UCTT)</b>
                    <ul>
                        <li><b>Tối ưu Cứng (Physical):</b> Bắt buộc ra trạm đo PIM, quét nhiễu ngoài, kiểm tra VSWR cáp Feeder, hoặc xoay hướng Ăng-ten (Azimuth) tránh đâm sóng đối diện.</li>
                        <li><b>Tối ưu Mềm:</b> Phân tích Alarms, rà soát cấu hình Neighbor List.</li>
                        <li><b>Giám sát Đóng Vòng:</b> CQI phải phục hồi trên 90% và Tỷ lệ Drop dưới 1% ở T+2.</li>
                    </ul>
                </div>
                <!-- Thanh công cụ phân trang Nhóm 2 -->
                <div class="table-toolbar">
                    <label style="font-size: 13px; font-weight: bold; color: #34495e;">
                        Hiển thị 
                        <select class="page-size-select" onchange="changePageSize(2, this)">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select> dòng/trang
                    </label>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Cell</th>
                                <th>CQI 4G<br><small style="color:#7f8c8d">< 90%</small></th>
                                <th>Service Drop<br><small style="color:#7f8c8d">> 1%</small></th>
                                <th>Thput DL<br><small style="color:#7f8c8d">Thực tế</small></th>
                                <th style="text-align: center;">CLOSED-LOOP VERIFICATION</th>
                            </tr>
                        </thead>
                        <tbody id="g2Body"></tbody>
                    </table>
                </div>
                <div id="pagination2"></div>
            </div>

            <!-- BƯỚC 5: NHÓM NGHẼN -->
            <div class="group-card" id="group3">
                <div class="group-header g3">
                    <div>MA TRẬN CẤP CỨU: NHÓM NGHẼN TÀI NGUYÊN (PRB liên tục > 70%)</div>
                    <div>Cần Xử Lý: <b id="g3Count" style="font-size: 18px;">0</b></div>
                </div>
                <div class="action-box">
                    <span class="action-badge">BƯỚC 5: ACTION</span> <b>Đầu mối: Đội RNO / Đội Quy Hoạch</b>
                    <ul>
                        <li><b>Tối ưu Mềm (Ưu tiên):</b> Bật và tinh chỉnh Load Balancing đẩy UE sang L2100, L900. Đổi mã PCI tránh xung đột lân cận.</li>
                        <li><b>Tối ưu Cứng:</b> Cụp góc ngẩng (Downtilt) hất User rìa ra khỏi vùng phủ.</li>
                        <li><b>Nâng Cấp:</b> Nếu trạm mãn tải thực sự, lập phiếu mở rộng License BBU, phát sóng thêm CA, nâng cấp từ 2T2R lên 4T4R.</li>
                    </ul>
                </div>
                <!-- Thanh công cụ phân trang Nhóm 3 -->
                <div class="table-toolbar">
                    <label style="font-size: 13px; font-weight: bold; color: #34495e;">
                        Hiển thị 
                        <select class="page-size-select" onchange="changePageSize(3, this)">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select> dòng/trang
                    </label>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Tên Cell</th>
                                <th>PRB DL<br><small style="color:#7f8c8d">> 70%</small></th>
                                <th>Thput DL<br><small style="color:#7f8c8d">< 15 Mbps</small></th>
                                <th>CQI 4G<br><small style="color:#7f8c8d">Thực tế</small></th>
                                <th style="text-align: center;">CLOSED-LOOP VERIFICATION</th>
                            </tr>
                        </thead>
                        <tbody id="g3Body"></tbody>
                    </table>
                </div>
                <div id="pagination3"></div>
            </div>

        </div>
    </main>
</div>

<script>
    // Tự động tải thư viện Excel
    document.addEventListener('DOMContentLoaded', function() {
        const xlsxScript = document.createElement('script');
        xlsxScript.src = atob('aHR0cHM6Ly91bnBrZy5jb20veGxzeC9kaXN0L3hsc3guZnVsbC5taW4uanM=');
        document.head.appendChild(xlsxScript);
    });

    /* STREAMING_CHUNK:Initialize Pagination Logic... */
    // Biến toàn cục để lưu trữ dữ liệu và trạng thái phân trang của từng nhóm
    window.optData = { 1: [], 2: [], 3: [] };
    window.optState = {
        1: { page: 1, size: 10 },
        2: { page: 1, size: 10 },
        3: { page: 1, size: 10 }
    };

    // Hàm xuất HTML cho từng dòng (Row)
    const renderRow = (r, type, index) => {
        let m = r.metrics;
        let v = r.vios;
        // Nếu API cũ chưa trả về vios, dùng tạm điều kiện fallback
        let badThput = v ? v.thput : (m.thput < 15);
        let badLatency = v ? v.latency : (m.latency > 50);
        let badPrb = v ? v.prb : (m.prb > 70);
        let badCqi = v ? v.cqi : (m.cqi < 90);
        let badDrop = v ? v.drop : (m.drop_rate > 1);

        let btn = `<a href="/kpi-analytics?network=4g&cell=${encodeURIComponent(r.Cell_Name)}" target="_blank" class="btn-kpi">📈 Trích Xuất KPI (T+1)</a>`;
        
        if(type === 1) return `<tr><td>${index}</td><td><b style="color:#8e44ad">${r.Cell_Name}</b></td><td class="${badThput ? 'metric-bad' : ''}">${m.thput}</td><td class="${badLatency ? 'metric-bad' : ''}">${m.latency}</td><td>${m.prb}</td><td style="text-align:center;">${btn}</td></tr>`;
        
        if(type === 2) return `<tr><td>${index}</td><td><b style="color:#e74c3c">${r.Cell_Name}</b></td><td class="${badCqi ? 'metric-bad' : ''}">${m.cqi}</td><td class="${badDrop ? 'metric-bad' : ''}">${m.drop_rate}</td><td>${m.thput}</td><td style="text-align:center;">${btn}</td></tr>`;
        
        if(type === 3) return `<tr><td>${index}</td><td><b style="color:#f39c12">${r.Cell_Name}</b></td><td class="${badPrb ? 'metric-bad' : ''}">${m.prb}</td><td class="${badThput ? 'metric-bad' : ''}">${m.thput}</td><td>${m.cqi}</td><td style="text-align:center;">${btn}</td></tr>`;
        return '';
    };

    // Hàm render dữ liệu theo từng trang
    function renderGroupTable(gId) {
        const data = window.optData[gId];
        const state = window.optState[gId];
        const tbody = document.getElementById(`g${gId}Body`);
        const pageControls = document.getElementById(`pagination${gId}`);
        
        if (!data || data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding: 25px; color: #7f8c8d; font-style: italic;">Không có dữ liệu vi phạm cho nhóm này.</td></tr>';
            pageControls.innerHTML = '';
            return;
        }

        const totalPages = Math.ceil(data.length / state.size);
        if (state.page > totalPages) state.page = totalPages;
        if (state.page < 1) state.page = 1;

        const startIdx = (state.page - 1) * state.size;
        const endIdx = Math.min(startIdx + state.size, data.length);
        
        const pageData = data.slice(startIdx, endIdx);
        tbody.innerHTML = pageData.map((r, i) => renderRow(r, gId, startIdx + i + 1)).join('');

        // Cập nhật giao diện thanh điều hướng phân trang
        let pageHtml = `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; background: #fdfdfd; border-top: 1px solid #ecf0f1; border-radius: 0 0 10px 10px;">
                <div style="font-size: 13px; color: #7f8c8d;">
                    Đang xem từ <b>${startIdx + 1}</b> đến <b>${endIdx}</b> trong tổng số <b>${data.length}</b> trạm
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <button class="page-btn" onclick="changePage(${gId}, ${state.page - 1})" ${state.page === 1 ? 'disabled' : ''}>❮ Trang Trước</button>
                    <span class="page-info-badge">Trang ${state.page} / ${totalPages}</span>
                    <button class="page-btn" onclick="changePage(${gId}, ${state.page + 1})" ${state.page === totalPages ? 'disabled' : ''}>Trang Sau ❯</button>
                </div>
            </div>
        `;
        pageControls.innerHTML = pageHtml;
    }

    function changePage(gId, newPage) {
        window.optState[gId].page = newPage;
        renderGroupTable(gId);
    }

    function changePageSize(gId, selectEl) {
        window.optState[gId].size = parseInt(selectEl.value);
        window.optState[gId].page = 1; 
        renderGroupTable(gId);
    }

    /* STREAMING_CHUNK:Fetching API data... */
    async function runOptimization() {
        const week = document.getElementById('weekSelect').value;
        const filterBL = document.getElementById('blacklistCheck').checked;

        document.getElementById('loadingMsg').style.display = 'block';
        document.getElementById('errorMsg').style.display = 'none';
        document.getElementById('summaryBox').style.display = 'none';
        document.getElementById('btnExport').style.display = 'none';
        ['group1', 'group2', 'group3'].forEach(id => document.getElementById(id).style.display = 'none');

        try {
            const response = await fetch(`/api/optimizing-data?week=${encodeURIComponent(week)}&filterBlacklist=${filterBL}`);
            const result = await response.json();

            document.getElementById('loadingMsg').style.display = 'none';

            if (result.error) {
                document.getElementById('errorMsg').innerText = result.error;
                document.getElementById('errorMsg').className = 'alert alert-danger';
                document.getElementById('errorMsg').style.display = 'block';
                return;
            }

            if (result.message) {
                document.getElementById('errorMsg').innerText = result.message;
                document.getElementById('errorMsg').className = 'alert alert-success';
                document.getElementById('errorMsg').style.color = '#27ae60';
                document.getElementById('errorMsg').style.backgroundColor = '#e8f8f5';
                document.getElementById('errorMsg').style.display = 'block';
                return;
            }

            document.getElementById('sumTotal').innerText = result.stats.totalBad;
            document.getElementById('sumBlack').innerText = result.stats.blacklisted;
            document.getElementById('sumLow').innerText = result.stats.lowTraffic || 0;
            document.getElementById('sumValid').innerText = result.stats.analyzed;
            document.getElementById('summaryBox').style.display = 'block';

            // Nạp dữ liệu vào biến toàn cục và hiển thị
            const data = result.data;
            window.optData[1] = data.group1 || [];
            window.optData[2] = data.group2 || [];
            window.optData[3] = data.group3 || [];
            
            // Reset trạng thái phân trang khi có dữ liệu mới
            window.optState[1].page = 1; window.optState[2].page = 1; window.optState[3].page = 1;
            
            let hasDataToExport = false;

            if (window.optData[1].length > 0) {
                document.getElementById('g1Count').innerText = window.optData[1].length;
                document.getElementById('group1').style.display = 'block';
                renderGroupTable(1);
                hasDataToExport = true;
            }

            if (window.optData[2].length > 0) {
                document.getElementById('g2Count').innerText = window.optData[2].length;
                document.getElementById('group2').style.display = 'block';
                renderGroupTable(2);
                hasDataToExport = true;
            }

            if (window.optData[3].length > 0) {
                document.getElementById('g3Count').innerText = window.optData[3].length;
                document.getElementById('group3').style.display = 'block';
                renderGroupTable(3);
                hasDataToExport = true;
            }

            if (hasDataToExport) {
                document.getElementById('btnExport').style.display = 'inline-block';
            }

        } catch (error) {
            document.getElementById('loadingMsg').style.display = 'none';
            document.getElementById('errorMsg').innerText = 'Lỗi kết nối đến máy chủ CSDL.';
            document.getElementById('errorMsg').style.display = 'block';
        }
    }

    // Hàm xuất dữ liệu ra Excel (Lấy từ biến toàn cục, không phụ thuộc UI đang phân trang)
    function exportToExcel() {
        if (typeof XLSX === 'undefined') {
            alert('Thư viện Excel chưa tải xong, vui lòng đợi thêm vài giây và bấm lại...');
            return;
        }

        let wb = XLSX.utils.book_new();
        let currentWeek = document.getElementById('weekSelect').value || 'CEM_QoS';
        let safeWeekName = currentWeek.replace(/[\\\/\:\*\?\"\<\>\|]/g, '_').replace(/\s+/g, '_').replace(/[\(\)]/g, '');

        const formatExcelData = (dataArray, groupType) => {
            return dataArray.map((r, i) => {
                let m = r.metrics;
                if (groupType === 1) return { "STT": i+1, "Tên Cell": r.Cell_Name, "Nhóm": "Truyền Dẫn", "Thput DL (Mbps)": m.thput, "Latency (ms)": m.latency, "PRB DL (%)": m.prb };
                if (groupType === 2) return { "STT": i+1, "Tên Cell": r.Cell_Name, "Nhóm": "Vô Tuyến", "CQI 4G (%)": m.cqi, "Service Drop (%)": m.drop_rate, "Thput DL (Mbps)": m.thput };
                if (groupType === 3) return { "STT": i+1, "Tên Cell": r.Cell_Name, "Nhóm": "Nghẽn", "PRB DL (%)": m.prb, "Thput DL (Mbps)": m.thput, "CQI 4G (%)": m.cqi };
                return {};
            });
        };

        if (window.optData[1].length > 0) XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(formatExcelData(window.optData[1], 1)), "P1_TruyenDan");
        if (window.optData[2].length > 0) XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(formatExcelData(window.optData[2], 2)), "P2_VoTuyen");
        if (window.optData[3].length > 0) XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(formatExcelData(window.optData[3], 3)), "P3_Nghen");

        if (wb.SheetNames.length === 0) {
            alert('Không có dữ liệu để xuất file!');
            return;
        }
        
        XLSX.writeFile(wb, `Danh_Sach_Toi_Uu_CEM_${safeWeekName}.xlsx`);
    }
</script>
</body>
</html>
