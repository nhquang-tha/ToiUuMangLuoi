<%- include('partials/head') %>
<%
    let activeUser = locals.currentUser || locals.user || (typeof currentUser !== 'undefined' ? currentUser : null);
    let rawRole = activeUser && activeUser.role ? activeUser.role : '';
    let normalizedRole = rawRole ? String(rawRole).trim().toLowerCase() : '';
    let sidebarUser = activeUser ? Object.assign({}, activeUser, { role: normalizedRole }) : null;
    let isAdmin = normalizedRole === 'admin';
%>
<style>
    .layout { display: flex; height: 100vh; overflow: hidden; background-color: #f4f6f8; }
    .main-content { flex: 1; overflow-y: auto; padding: 20px; position: relative; }
    
    .filter-card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px; display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; border-top: 4px solid #3498db;}
    
    /* CẤU HÌNH THANH CUỘN VÀ BẢNG */
    .table-container { background: #fff; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); display: none; animation: fadeIn 0.5s ease; border: 1px solid #ecf0f1; overflow: hidden; }
    .table-wrapper { width: 100%; max-height: 65vh; overflow-y: auto; overflow-x: auto; }
    
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; white-space: nowrap; }
    .data-table th, .data-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #ecf0f1; }
    
    /* TIÊU ĐỀ CỐ ĐỊNH TỪNG CỘT */
    .data-table th { background-color: #f8f9fa; color: #2c3e50; font-weight: bold; position: sticky; top: 0; z-index: 10; text-transform: uppercase; font-size: 11px; box-shadow: 0 2px 2px -1px rgba(0,0,0,0.1); }
    .data-table tbody tr:hover td { background-color: #f4f9fd; }

    /* NÚT THAO TÁC (Sửa/Xóa) */
    .btn-edit { background: #f39c12; color: white; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 11px; font-weight: bold; transition: 0.2s; border: none; cursor: pointer; display: inline-block;}
    .btn-edit:hover { background: #e67e22; }
    .btn-del { background: #e74c3c; color: white; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 11px; font-weight: bold; transition: 0.2s; border: none; cursor: pointer; display: inline-block; margin-left: 5px;}
    .btn-del:hover { background: #c0392b; }

    /* CẤU HÌNH PHÂN TRANG (PAGINATION) */
    .pagination-bar { padding: 12px 20px; background: #fff; border-top: 1px solid #ecf0f1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
    .page-info select { padding: 6px 10px; border-radius: 6px; border: 1px solid #bdc3c7; outline: none; cursor: pointer; font-weight: bold; color: #2c3e50;}
    .page-controls { display: flex; gap: 5px; }
    .btn-page { background: #f8f9fa; border: 1px solid #bdc3c7; padding: 6px 12px; border-radius: 6px; cursor: pointer; color: #34495e; font-weight: bold; transition: 0.2s;}
    .btn-page:hover:not(:disabled) { background: #3498db; color: white; border-color: #3498db; }
    .btn-page.active { background: #3498db; color: white; border-color: #3498db; }
    .btn-page:disabled { opacity: 0.5; cursor: not-allowed; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<!-- CHUYỂN BIẾN ADMIN SANG JAVASCRIPT ĐỂ BẬT TẮT NÚT XÓA -->
<script>
    const IS_ADMIN = <%= isAdmin ? 'true' : 'false' %>;
</script>

<div class="layout">
    <%- include('partials/sidebar', { currentUser: sidebarUser }) %>
    <main class="main-content">
        <header class="topbar">
            <h1>Cơ Sở Dữ Liệu RF (Cấu Hình Trạm)</h1>
        </header>
        
        <div class="content-body">
            
            <div class="filter-card">
                <div style="flex: 1; min-width: 200px;">
                    <label style="display:block; margin-bottom:8px; font-weight:bold; color:#2c3e50;">Loại Mạng (Database):</label>
                    <select id="networkSelect" style="width: 100%; padding: 12px; border: 1px solid #bdc3c7; border-radius: 6px; outline: none; cursor: pointer; font-size: 14px; border-left: 4px solid #3498db;">
                        <option value="4g" selected>RF Mạng 4G LTE</option>
                        <option value="5g">RF Mạng 5G NR</option>
                        <option value="3g">RF Mạng 3G WCDMA</option>
                    </select>
                </div>
                <div style="flex: 2; min-width: 250px;">
                    <label style="display:block; margin-bottom:8px; font-weight:bold; color:#2c3e50;">Tìm kiếm (Nhập Tên Cell hoặc Site):</label>
                    <input type="text" id="searchInput" placeholder="Ví dụ: THA001M hoặc THA001..." onkeypress="if(event.key === 'Enter') fetchRFData()" style="width: 100%; padding: 12px; border: 1px solid #bdc3c7; border-radius: 6px; outline: none;">
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button onclick="fetchRFData()" class="btn-primary" style="background: #3498db; color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; height: 45px; font-size: 14px; transition: 0.2s;">
                        🔍 Lọc & Tải Dữ Liệu
                    </button>
                    <% if (isAdmin) { %>
                        <a href="#" id="btnAdd" class="btn-primary" style="background: #f39c12; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; padding: 0 20px; font-weight: bold; height: 45px; font-size: 14px;">➕ Thêm Trạm</a>
                    <% } %>
                    <button onclick="exportToExcel()" id="btnExport" class="btn-success" style="background: #27ae60; color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; height: 45px; font-size: 14px; display: none;">
                        📥 Xuất Excel
                    </button>
                </div>
            </div>

            <div id="loadingMsg" style="display: none; text-align: center; padding: 30px; color: #3498db; font-size: 16px; font-weight: bold; background: white; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 15px;">
                <span style="display: inline-block; animation: spin 1s linear infinite;">⏳</span> Đang tải dữ liệu mạng lưới RF...
            </div>
            
            <div id="errorMsg" style="display: none; text-align: center; padding: 20px; color: #e74c3c; font-weight: bold; background: #fdf2f2; border: 1px solid #fad2d2; border-radius: 8px; margin-bottom: 15px;"></div>

            <!-- BẢNG CÓ PHÂN TRANG -->
            <div class="table-container" id="tableContainer">
                <div style="padding: 15px 20px; border-bottom: 1px solid #ecf0f1; font-weight: bold; color: #2980b9; background: #fdfdfd;">
                    Tổng số bản ghi tìm thấy: <span id="totalCount" style="font-size: 16px; color:#e74c3c;">0</span>
                </div>
                
                <div class="table-wrapper">
                    <table class="data-table" id="rfTable">
                        <thead id="tableHead">
                            <!-- JS tự động vẽ tiêu đề cột -->
                        </thead>
                        <tbody id="tableBody">
                            <!-- JS tự động vẽ Data -->
                        </tbody>
                    </table>
                </div>

                <!-- THANH PHÂN TRANG -->
                <div class="pagination-bar">
                    <div class="page-info">
                        Hiển thị 
                        <select id="pageSize" onchange="changePageSize()">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50" selected>50</option>
                            <option value="100">100</option>
                        </select> 
                        dòng / trang
                    </div>
                    <div class="page-controls" id="pageControls">
                        <!-- Nút trang sẽ được gen bằng JS -->
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const xlsxScript = document.createElement('script');
        xlsxScript.src = atob('aHR0cHM6Ly91bnBrZy5jb20veGxzeC9kaXN0L3hsc3guZnVsbC5taW4uanM=');
        document.head.appendChild(xlsxScript);
        
        // Tự động tải dữ liệu khi vừa mở trang (Bắt đầu với 4G)
        fetchRFData();
    });

    // Biến toàn cục quản lý Phân trang
    window.cachedData = [];
    window.currentColumns = [];
    window.currentPage = 1;
    window.rowsPerPage = 50; // Mặc định hiển thị 50 trạm cho gọn

    async function fetchRFData() {
        const net = document.getElementById('networkSelect').value;
        const search = document.getElementById('searchInput').value.trim();
        
        if (IS_ADMIN) {
            document.getElementById('btnAdd').href = `/rf-database/add/${net}`;
        }

        document.getElementById('loadingMsg').style.display = 'block';
        document.getElementById('errorMsg').style.display = 'none';
        document.getElementById('tableContainer').style.display = 'none';
        document.getElementById('btnExport').style.display = 'none';

        try {
            // Tận dụng chính API Xuất Excel sẵn có trong Controller để lấy JSON cực nhanh
            const response = await fetch(`/rf-database/export?network=${net}&search=${encodeURIComponent(search)}`);
            if (!response.ok) throw new Error('Lỗi máy chủ');
            const data = await response.json();
            
            document.getElementById('loadingMsg').style.display = 'none';

            if (data.length === 0) {
                document.getElementById('errorMsg').innerText = `Không tìm thấy trạm/cell nào khớp với từ khóa tìm kiếm.`;
                document.getElementById('errorMsg').style.display = 'block';
                return;
            }

            // Lưu vào Cache và Render Trang 1
            window.cachedData = data;
            document.getElementById('totalCount').innerText = data.length.toLocaleString('vi-VN');
            window.currentPage = 1;
            
            renderTableHeaders();
            renderTablePage();

            document.getElementById('tableContainer').style.display = 'block';
            document.getElementById('btnExport').style.display = 'block';

        } catch (error) {
            console.error(error);
            document.getElementById('loadingMsg').style.display = 'none';
            document.getElementById('errorMsg').innerText = 'Lỗi truy xuất dữ liệu từ Database. Có thể do đứt kết nối mạng.';
            document.getElementById('errorMsg').style.display = 'block';
        }
    }

    function renderTableHeaders() {
        if (window.cachedData.length === 0) return;
        const thead = document.getElementById('tableHead');
        
        // Tự động quét Header từ JSON (ẩn các cột id và created_at không cần thiết)
        const columns = Object.keys(window.cachedData[0]).filter(k => k !== 'id' && k !== 'created_at');
        
        let html = '<tr>';
        // Ép cố định (Sticky) cột Thao Tác ở ngoài cùng bên trái cho Admin
        if (IS_ADMIN) {
            html += '<th style="position: sticky; left: 0; z-index: 11; background: #ecf0f1; border-right: 2px solid #bdc3c7;">Thao Tác</th>';
        }
        html += '<th>STT</th>';
        
        columns.forEach(col => {
            html += `<th>${col.replace(/_/g, ' ')}</th>`;
        });
        html += '</tr>';
        
        thead.innerHTML = html;
        window.currentColumns = columns;
    }

    function renderTablePage() {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        const net = document.getElementById('networkSelect').value;

        const start = (window.currentPage - 1) * window.rowsPerPage;
        const end = start + window.rowsPerPage;
        const pageData = window.cachedData.slice(start, end);

        pageData.forEach((row, index) => {
            const tr = document.createElement('tr');
            let html = '';
            
            // Cột Thao tác (Sticky)
            if (IS_ADMIN) {
                html += `<td style="position: sticky; left: 0; background: #fff; z-index: 5; border-right: 2px solid #ecf0f1;">
                    <div style="display:flex; gap:5px;">
                        <a href="/rf-database/edit/${net}/${row.id}" class="btn-edit">Sửa</a>
                        <form action="/rf-database/delete/${net}/${row.id}" method="POST" style="margin:0;" onsubmit="return confirm('CẢNH BÁO: Xóa bản ghi này khỏi cơ sở dữ liệu? Hành động không thể hoàn tác!');">
                            <button type="submit" class="btn-del">Xóa</button>
                        </form>
                    </div>
                </td>`;
            }
            
            html += `<td><b>${start + index + 1}</b></td>`;
            
            // Render linh động theo cột Data của loại mạng
            window.currentColumns.forEach(col => {
                let val = row[col];
                if (val === null || val === undefined) val = '';
                // Highlight tên Cell
                if (col.toLowerCase() === 'cell_code' || col.toLowerCase() === 'cell_name' || col.toLowerCase() === 'site_name') {
                    html += `<td><b style="color: #2980b9;">${val}</b></td>`;
                } else {
                    html += `<td>${val}</td>`;
                }
            });

            tr.innerHTML = html;
            tbody.appendChild(tr);
        });

        // Xử lý hiệu ứng hover cho cột Sticky không bị lạc quẻ màu nền
        const trs = tbody.querySelectorAll('tr');
        trs.forEach(tr => {
            tr.addEventListener('mouseenter', () => {
                const td = tr.querySelector('td[style*="sticky"]');
                if(td) td.style.backgroundColor = '#f4f9fd';
            });
            tr.addEventListener('mouseleave', () => {
                const td = tr.querySelector('td[style*="sticky"]');
                if(td) td.style.backgroundColor = '#fff';
            });
        });

        renderPaginationControls();
    }

    function renderPaginationControls() {
        const totalPages = Math.ceil(window.cachedData.length / window.rowsPerPage);
        const controls = document.getElementById('pageControls');
        controls.innerHTML = '';

        if (totalPages <= 1) return;

        controls.insertAdjacentHTML('beforeend', `<button class="btn-page" onclick="goToPage(${window.currentPage - 1})" ${window.currentPage === 1 ? 'disabled' : ''}>&laquo; Trước</button>`);

        for (let i = 1; i <= totalPages; i++) {
            // Chỉ hiện các trang xung quanh trang hiện tại để chống tràn UI
            if (i === 1 || i === totalPages || (i >= window.currentPage - 2 && i <= window.currentPage + 2)) {
                controls.insertAdjacentHTML('beforeend', `<button class="btn-page ${window.currentPage === i ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`);
            } else if (i === window.currentPage - 3 || i === window.currentPage + 3) {
                controls.insertAdjacentHTML('beforeend', `<span style="padding: 5px;">...</span>`);
            }
        }

        controls.insertAdjacentHTML('beforeend', `<button class="btn-page" onclick="goToPage(${window.currentPage + 1})" ${window.currentPage === totalPages ? 'disabled' : ''}>Sau &raquo;</button>`);
    }

    function goToPage(page) {
        const totalPages = Math.ceil(window.cachedData.length / window.rowsPerPage);
        if (page >= 1 && page <= totalPages) {
            window.currentPage = page;
            renderTablePage();
            document.querySelector('.table-wrapper').scrollTop = 0; // Trở về đầu bảng
        }
    }

    function changePageSize() {
        window.rowsPerPage = parseInt(document.getElementById('pageSize').value);
        window.currentPage = 1;
        renderTablePage();
        document.querySelector('.table-wrapper').scrollTop = 0;
    }

    function exportToExcel() {
        if (typeof XLSX === 'undefined') {
            alert('Thư viện Excel chưa tải xong, vui lòng đợi...'); return;
        }
        
        let net = document.getElementById('networkSelect').value.toUpperCase();
        
        // Tạo dữ liệu xuất từ mảng Cache đầy đủ (Không bị giới hạn bởi Pagination)
        let exportData = window.cachedData.map((row, i) => {
            let obj = { "STT": i + 1 };
            window.currentColumns.forEach(col => {
                obj[col.replace(/_/g, ' ').toUpperCase()] = row[col];
            });
            return obj;
        });

        let ws = XLSX.utils.json_to_sheet(exportData);
        let wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, `RF_${net}`);
        
        let search = document.getElementById('searchInput').value.trim();
        let fileName = search ? `Co_So_Du_Lieu_RF_${net}_${search}.xlsx` : `Co_So_Du_Lieu_RF_${net}_ToanBo.xlsx`;
        
        XLSX.writeFile(wb, fileName);
    }
</script>
</body>
</html>
